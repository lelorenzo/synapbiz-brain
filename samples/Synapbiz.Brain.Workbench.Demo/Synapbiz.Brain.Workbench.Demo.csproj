<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Synapbiz.Brain.Workbench.Demo</RootNamespace>
  </PropertyGroup>

  <!-- An SDK 10 that builds this net9.0 host does not restore the framework script of the interactive server render mode; an SDK 9 brings it by itself. -->
  <ItemGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Synapbiz.Brain.Contracts/Synapbiz.Brain.Contracts.csproj" />
    <ProjectReference Include="../../src/Synapbiz.Brain.Engine/Synapbiz.Brain.Engine.csproj" />
    <ProjectReference Include="../../src/Synapbiz.Brain.Process/Synapbiz.Brain.Process.csproj" />
    <ProjectReference Include="../../src/Synapbiz.Brain.Spec/Synapbiz.Brain.Spec.csproj" />
    <ProjectReference Include="../../src/Synapbiz.Brain.Workbench/Synapbiz.Brain.Workbench.csproj" />
    <ProjectReference Include="../../src/Synapbiz.Brain.Workbench.Blazor/Synapbiz.Brain.Workbench.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../tests/fixtures/workbench/*.json" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../tests/fixtures/brain-spec/readiness.*.json" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../process-reference/**/*.json" Link="process-reference/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
