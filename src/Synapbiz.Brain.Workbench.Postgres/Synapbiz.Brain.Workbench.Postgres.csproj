<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Synapbiz.Brain.Workbench.Postgres</RootNamespace>
    <AssemblyName>Synapbiz.Brain.Workbench.Postgres</AssemblyName>
    <PackageId>Synapbiz.Brain.Workbench.Postgres</PackageId>
    <IsPackable>true</IsPackable>
