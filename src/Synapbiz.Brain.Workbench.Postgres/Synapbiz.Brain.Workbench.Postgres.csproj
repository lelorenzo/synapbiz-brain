  <ItemGroup>
    <ProjectReference Include="../Synapbiz.Brain.Workbench/Synapbiz.Brain.Workbench.csproj" />
    <ProjectReference Include="../Synapbiz.Brain.Host.Postgres/Synapbiz.Brain.Host.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Synapbiz.Brain.Host.Postgres.Tests" />
  </ItemGroup>

</Project>
