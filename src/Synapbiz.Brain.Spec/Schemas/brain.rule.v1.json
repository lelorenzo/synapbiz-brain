{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapbiz.example/brain.rule/1",
  "type": "object",
  "properties": {
    "$spec": {
      "const": "brain.rule@1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$ref": {
            "type": "string"
          }
        },
        "required": [
          "$ref"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*@[1-9][0-9]*$"
      },
      "uniqueItems": true
    },
    "meta": {
      "type": "object"
    },
    "body": {
      "$ref": "#/$defs/rule"
    },
    "$v0": {
      "type": "object"
    },
    "$scope": {
      "type": "object"
    }
  },
  "required": [
    "$spec",
    "id",
    "version",
    "uses",
    "requires",
    "meta",
    "body"
  ],
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 3
        },
        "hitPolicy": {
          "enum": [
            "unique",
            "first",
            "collect"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "defaultRow": {
          "anyOf": [
            {
              "$ref": "#/$defs/row"
            },
            {
              "type": "null"
            }
          ]
        },
        "goldens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/golden"
          }
        }
      },
      "required": [
        "kind",
        "hitPolicy",
        "rows",
        "goldens"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "legacyKey": {
          "type": "string",
          "pattern": "\\S"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "outcome": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "version",
        "legacyKey",
        "conditions",
        "outcome"
      ],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "fact": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "any",
            "equals",
            "notEquals",
            "in",
            "notIn",
            "isNull",
            "isNotNull",
            "range",
            "startsWith"
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "upper": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "lowerInclusive": {
          "type": "boolean"
        },
        "upperInclusive": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      },
      "required": [
        "fact",
        "op"
      ],
      "additionalProperties": false
    },
    "value": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "Code",
            "Enum",
            "Boolean",
            "Integer",
            "Decimal",
            "Money",
            "Date",
            "Reference"
          ]
        },
        "value": {},
        "allowedValues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Code"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Enum"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Boolean"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Integer"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Decimal"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Money"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Date"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Reference"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "properties": {
                  "guid": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "labelSource": {
                    "type": "object",
                    "properties": {
                      "ownerModule": {
                        "type": "string",
                        "minLength": 1
                      },
                      "entityType": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "ownerModule",
                      "entityType"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "guid"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "golden": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "expect": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "noDecision": {
                  "const": true
                }
              },
              "required": [
                "noDecision"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "row": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                },
                "outcome": {
                  "oneOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  ]
                }
              },
              "required": [],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "row"
                  ]
                },
                {
                  "required": [
                    "outcome"
                  ]
                }
              ]
            }
          ]
        }
      },
      "required": [
        "name",
        "facts",
        "expect"
      ],
      "additionalProperties": false
    }
  }
}
