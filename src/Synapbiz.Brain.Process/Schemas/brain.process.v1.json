        "input": {
          "$ref": "#/$defs/mapping"
        },
        "output": {
          "$ref": "#/$defs/mapping"
        },
        "next": {
          "$ref": "#/$defs/id"
        },
        "on": {
          "$ref": "#/$defs/stepMap"
        },
        "onError": {
          "$ref": "#/$defs/id"
        }
