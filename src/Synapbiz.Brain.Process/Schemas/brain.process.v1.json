        "required": [
          "delivery"
        ]
      },
      "then": {
        "required": [
          "onUnknown"
        ]
      },
      "else": {
        "properties": {
          "onUnknown": false
        }
      }
    },
    "ai": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ai"
        },
        "stage": {
          "$ref": "#/$defs/text"
        },
        "port": {
          "$ref": "#/$defs/text"
        },
        "model": {
          "$ref": "#/$defs/text"
        },
        "prompt": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/text"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "input": {
          "$ref": "#/$defs/mapping"
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "output": {
          "$ref": "#/$defs/mapping"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "next": {
          "$ref": "#/$defs/id"
        },
        "onInvalid": {
          "$ref": "#/$defs/id"
        },
        "onError": {
          "$ref": "#/$defs/id"
        },
        "onNotAvailable": {
          "$ref": "#/$defs/id"
        },
        "onNotEntitled": {
          "$ref": "#/$defs/id"
        }
