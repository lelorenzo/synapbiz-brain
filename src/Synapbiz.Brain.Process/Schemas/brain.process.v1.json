        "rule": {
          "$ref": "#/$defs/id"
        },
        "facts": {
          "$ref": "#/$defs/mapping"
        },
        "output": {
          "$ref": "#/$defs/mapping"
        },
        "route": {
          "$ref": "#/$defs/text"
        },
        "on": {
          "$ref": "#/$defs/stepMap"
        },
        "next": {
          "$ref": "#/$defs/id"
        },
        "collectInto": {
          "$ref": "#/$defs/text"
        },
        "onNoDecision": {
          "$ref": "#/$defs/id"
        },
        "onError": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind",
        "rule",
        "facts",
        "onNoDecision"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "route": [
          "on"
        ],
        "on": [
          "route"
        ]
      },
      "if": {
        "required": [
          "next"
        ]
      },
      "then": {
        "properties": {
          "route": false
        }
      },
      "else": {
        "required": [
          "route"
        ]
      }
    },
    "humanTask": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "humanTask"
        },
        "stage": {
          "$ref": "#/$defs/text"
        },
        "queue": {
          "$ref": "#/$defs/text"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "show": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "output": {
          "$ref": "#/$defs/mapping"
