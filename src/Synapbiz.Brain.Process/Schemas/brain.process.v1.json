        "contact": {
          "type": "boolean"
        },
        "window": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind",
        "port",
        "next",
        "delivery"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "delivery": {
            "const": "atMostOnce"
          }
