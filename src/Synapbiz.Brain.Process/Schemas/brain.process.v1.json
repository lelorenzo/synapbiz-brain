            "action",
            "ai",
            "decide",
            "humanTask",
            "wait",
            "timer",
            "loop",
            "subprocess",
            "end",
            "poll"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "read"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/read"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/action"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ai"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/ai"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decide"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/decide"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "humanTask"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/humanTask"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wait"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/wait"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "timer"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/timer"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loop"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/loop"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "subprocess"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/subprocess"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "end"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/end"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "poll"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/poll"
          }
        }
      ]
