        "event": {
          "$ref": "#/$defs/text"
        },
        "correlation": {
          "$ref": "#/$defs/text"
        },
        "output": {
          "$ref": "#/$defs/mapping"
        },
        "next": {
          "$ref": "#/$defs/id"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
