        }
      },
      "required": [
        "kind",
        "queue",
        "outcomes",
        "on"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "timeout": [
          "onTimeout"
        ],
        "onTimeout": [
          "timeout"
        ]
      }
    },
    "wait": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "wait"
        },
        "stage": {
          "$ref": "#/$defs/text"
