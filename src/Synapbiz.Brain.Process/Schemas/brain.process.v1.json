            "Enum",
            "Boolean",
            "Integer",
            "Decimal",
            "Money",
            "Date",
            "Reference",
            "Instant",
            "Json"
          ]
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "input": {
          "type": "boolean"
        },
        "initial": {}
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/text"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "variables": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/variable"
          }
        },
        "accepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxSteps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "additionalProperties": false
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trigger"
          }
        },
        "windows": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/window"
          }
        },
        "start": {
          "$ref": "#/$defs/id"
