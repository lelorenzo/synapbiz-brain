      ],
      "additionalProperties": false,
      "dependentRequired": {
        "timeout": [
          "onTimeout"
        ],
        "onTimeout": [
          "timeout"
        ]
      }
    },
    "timer": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "timer"
        },
        "stage": {
          "$ref": "#/$defs/text"
        },
        "after": {
          "$ref": "#/$defs/duration"
        },
        "until": {
          "$ref": "#/$defs/text"
        },
        "offset": {
          "$ref": "#/$defs/signedDuration"
        },
        "next": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind",
        "next"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "offset": [
          "until"
        ]
      },
      "if": {
        "required": [
          "after"
        ]
      },
      "then": {
        "properties": {
          "until": false
        }
      },
      "else": {
        "required": [
          "until"
        ]
      }
    },
    "loop": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "loop"
        },
        "stage": {
          "$ref": "#/$defs/text"
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "body": {
          "$ref": "#/$defs/id"
        },
        "onExhausted": {
          "$ref": "#/$defs/id"
        },
        "forEach": {
          "$ref": "#/$defs/text"
        },
        "item": {
          "$ref": "#/$defs/text"
        },
        "next": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "kind",
        "maxIterations",
        "body",
        "onExhausted"
