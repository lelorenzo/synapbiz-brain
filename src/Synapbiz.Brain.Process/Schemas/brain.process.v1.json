{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synapbiz.example/brain.process/1",
  "type": "object",
  "properties": {
    "$spec": {
      "const": "brain.process@1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*/[A-Za-z0-9_][A-Za-z0-9_.-]*$"
          }
        },
        "required": [
          "$ref"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*@[1-9][0-9]*$"
      },
      "uniqueItems": true
    },
    "meta": {
      "type": "object"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "required": [
    "$spec",
    "id",
    "version",
    "uses",
    "requires",
    "meta",
    "body"
