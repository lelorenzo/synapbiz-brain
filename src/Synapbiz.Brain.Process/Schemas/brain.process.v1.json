        "stage": {
          "$ref": "#/$defs/text"
        },
        "port": {
          "$ref": "#/$defs/text"
        },
        "input": {
          "$ref": "#/$defs/mapping"
        },
        "output": {
          "$ref": "#/$defs/mapping"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "next": {
          "$ref": "#/$defs/id"
        },
        "onError": {
          "$ref": "#/$defs/id"
        },
        "onNotAvailable": {
          "$ref": "#/$defs/id"
        },
        "onNotEntitled": {
          "$ref": "#/$defs/id"
