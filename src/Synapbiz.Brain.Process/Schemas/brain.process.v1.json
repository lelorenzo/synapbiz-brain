            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/step"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          }
        }
      },
      "required": [
        "subject",
        "stages",
        "variables",
        "start",
        "steps"
      ],
      "additionalProperties": false
    },
