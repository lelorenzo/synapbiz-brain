@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Synapbiz.Brain.Process
@using Synapbiz.Brain.Workbench
@using Synapbiz.Brain.Workbench.Flows
@using System.Globalization
@implements IDisposable

<div class="wb-root" lang="@LangCode">
    @if (ViewBarShown)
    {
        @ViewBar()
    }
    @if (ShowMap)
    {
        @MapLayout()
    }
    else if (ShowLive)
    {
        @LiveLayout()
    }
    else
    {
    <div class="wb-main">
        <div class="wb-panel wb-list-panel">
            <div class="wb-ph">
                <h2 class="wb-title">@Rich("flow.list.title")</h2>
                @if (Flows is not null)
                {
                    <div class="wb-meta">@CountLine()</div>
                }
            </div>
            @if (Flows is null)
            {
                <div class="wb-skeletons" aria-hidden="true">
                    <div class="wb-skeleton"></div>
                    <div class="wb-skeleton"></div>
                    <div class="wb-skeleton"></div>
                </div>
            }
            else if (Flows.Count > 0)
            {
                var selectedKey = SelectedFlow?.Key;
                <div class="wb-list-select-wrap">
                    <select class="wb-in wb-list-select" aria-label="@Plain("flow.list.aria")" value="@(Flows.ToList().FindIndex(item => item.Key == selectedKey).ToString(CultureInfo.InvariantCulture))" @onchange="SelectFromList">
                        @for (var position = 0; position < Flows.Count; position++)
                        {
                            <option value="@position.ToString(CultureInfo.InvariantCulture)">@TitleOf(Flows[position])</option>
                        }
                    </select>
                </div>
                <nav class="wb-list" aria-label="@Plain("flow.list.aria")">
                    @if (SharedGroup is { } sharedGroup)
                    {
                        <p class="wb-group-once">@sharedGroup</p>
                    }
                    @foreach (var section in KindSections())
                    {
                        <section class="wb-kind-section" aria-labelledby="@(idp + "-k" + section.Ordinal)">
                            <h3 class="wb-kind" id="@(idp + "-k" + section.Ordinal)">@KindHeading(section.Kind)</h3>
                            @foreach (var group in section.Groups)
                            {
                                <section class="wb-group-section">
                                    @if (group.Heading is not null)
                                    {
                                        <h4 class="wb-group" id="@(idp + "-k" + section.Ordinal + "g" + group.Ordinal)">@group.Heading</h4>
                                    }
                                    <ul class="wb-rules" aria-labelledby="@(group.Heading is not null ? idp + "-k" + section.Ordinal + "g" + group.Ordinal : idp + "-k" + section.Ordinal)">
                                        @foreach (var entry in group.Entries)
                                        {
                                            var flow = entry.Flow;
                                            var index = entry.Index;
                                            var selected = string.Equals(flow.Key, selectedKey, StringComparison.Ordinal);
                                            var d = Data(flow);
                                            <li>
                                                <button type="button" class="wb-rule" aria-current="@(selected ? "true" : null)" @onclick="() => SelectFlow(flow.Key)" @onkeydown="OnListKeyDown" @ref="refs[FlowRef(index)]">
                                                    @{ Seen(FlowRef(index)); }
                                                    <span class="wb-rule-t">
                                                        <span class="wb-rule-name">@TitleOf(flow)</span>
                                                        @if (d is null)
                                                        {
                                                            <span class="@PillClass("neutral")">@Rich("flow.list.unreadable")</span>
                                                        }
                                                        else
                                                        {
                                                            @KindMark(d.Entry.Kind)
                                                            @if (VersionLine(flow, d) is { } versionLine)
                                                            {
                                                                <span class="wb-sub">@versionLine</span>
                                                            }
                                                        }
                                                    </span>
                                                    @if (d is not null)
                                                    {
                                                        <span class="wb-rule-s">
                                                            <span class="wb-flow-l">@Sentence(StartsLine(d))</span>
                                                            <span class="wb-flow-l">@PluralText("flow.list.steps", d.Outline.Steps.Count) · @PluralText("flow.list.scenarios", d.Entry.ScenarioCount)</span>
                                                            <span class="wb-flow-l">@TestsLine(d) · @Plain("flow.list.routes", ("n", Number(d.Coverage.CoveredRoutes)), ("t", Number(d.Coverage.TotalRoutes)))</span>
                                                            <span class="wb-flow-l">@ReviewLine(flow, d)@NeedsNotePill(flow, d)</span>
                                                        </span>
                                                    }
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </section>
                            }
                        </section>
                    }
                </nav>
            }
        </div>

        <div class="wb-panel wb-detail">
            @if (Flows is null)
            {
                <div class="wb-body wb-sub" role="status">@Rich("flow.load.loading")</div>
            }
            else if (Flows.Count == 0)
            {
                <div class="wb-body wb-sub">@Rich("flow.list.empty")</div>
            }
            else if (SelectedFlow is { } current)
            {
                @DetailPanel(current)
            }
        </div>
    </div>
    }
    @IconSprite()
</div>

@code {
    // ----- icons ------------------------------------------------------------------------------------------------------

    /// <summary>One symbol of the sprite, drawn in the colour of the text around it. Never alone: a word always goes with it.</summary>
    private RenderFragment Icon(string name) => @<svg class="wb-i" aria-hidden="true" focusable="false"><use href="@("#" + idp + "-i-" + name)"></use></svg>;

    /// <summary>The symbols of every kind of piece, drawn once per instance: stroke in the current colour, no icon font, no script.</summary>
    private RenderFragment IconSprite() => @<svg class="wb-sprite" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
            <symbol id="@(idp + "-i-main")" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"></rect><path d="M3 9h18M9 9v11M15 9v11"></path></symbol>
            <symbol id="@(idp + "-i-sub")" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M7 6v12M17 6v12"></path></symbol>
            <symbol id="@(idp + "-i-sch")" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></symbol>
            <symbol id="@(idp + "-i-ev")" viewBox="0 0 24 24"><path d="M13 3 5 13h6l-1 8 8-10h-6z"></path></symbol>
            <symbol id="@(idp + "-i-rule")" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18M3 15h18M10 4v16"></path></symbol>
            <symbol id="@(idp + "-i-con")" viewBox="0 0 24 24"><path d="M9 3v5M15 3v5M7 8h10v4a5 5 0 0 1-10 0zM12 17v4"></path></symbol>
            <symbol id="@(idp + "-i-per")" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path></symbol>
            <symbol id="@(idp + "-i-ai")" viewBox="0 0 24 24"><path d="M12 3l1.9 5.6L19.5 10.5 13.9 12.4 12 18l-1.9-5.6L4.5 10.5l5.6-1.9zM19 16v4M17 18h4"></path></symbol>
            <symbol id="@(idp + "-i-go")" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></symbol>
            <symbol id="@(idp + "-i-dia")" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="6" rx="1"></rect><rect x="14" y="15" width="7" height="6" rx="1"></rect><path d="M6.5 9v5a2 2 0 0 0 2 2H14"></path></symbol>
        </defs>
    </svg>;

    /// <summary>The icon and the word of a kind of process, always together.</summary>
    private RenderFragment KindMark(FlowKind kind) => @<span class="@("wb-kindmark " + KindTone(kind))">@Icon(KindIcon(kind))<span>@KindWord(kind)</span></span>;

    private string KindHeading(FlowKind? kind) => kind is { } value ? KindsWord(value) : Plain("flow.list.kind.none");

    // ----- the view bar -----------------------------------------------------------------------------------------------

    private RenderFragment ViewBar() => @<div class="wb-viewbar" role="group" aria-label="@Plain("flow.view.label")">
        <button type="button" class="wb-seg-part" aria-pressed="@(EffectiveView == FlowWorkbenchView.Map ? "true" : "false")" @onclick="() => ChooseView(FlowWorkbenchView.Map)">@Rich("flow.view.map")</button>
        <button type="button" class="wb-seg-part" aria-pressed="@(EffectiveView == FlowWorkbenchView.List ? "true" : "false")" @onclick="() => ChooseView(FlowWorkbenchView.List)">@Rich("flow.view.list")</button>
        @if (LiveSource is not null)
        {
            <button type="button" class="wb-seg-part" aria-pressed="@(EffectiveView == FlowWorkbenchView.Live ? "true" : "false")" @onclick="ChooseLiveViewAsync">@Rich("flow.view.live")</button>
        }
    </div>;

    // ----- the map ----------------------------------------------------------------------------------------------------

    private RenderFragment MapLayout()
    {
        var selected = Session.ProcessOpen && SelectedFlow is { IsReadable: true } chosen ? chosen : null;
        var full = selected is not null && Session.FullDiagram && Session.SelectedTab == FlowWorkbenchTab.Diagram;
        var layoutClass = "wb-mapgrid" + (selected is not null ? " wb-open" : string.Empty) + (full ? " wb-full" : string.Empty);
        return @<div class="@layoutClass">
            @if (!full)
            {
                @MapPanel()
            }
            @if (selected is not null)
            {
                <div class="wb-panel wb-detail wb-side" role="region" aria-label="@Plain("flow.map.side.label")">
                    @Crumb(selected, full)
                    @DetailPanel(selected)
                </div>
            }
        </div>;
    }

    private RenderFragment Crumb(WorkbenchFlow open, bool full)
    {
        var parent = Parent(open);
        var title = TitleOf(open);
        return @<nav class="wb-crumb" aria-label="@Plain("flow.map.crumb.label")">
            <ol class="wb-crumb-list">
                <li><button type="button" class="wb-crumb-btn" @onclick="CloseProcess">@Rich("flow.view.map")</button></li>
                @if (parent is { } from)
                {
                    <li><button type="button" class="wb-crumb-btn" @onclick="() => OpenProcess(from.Id, null)">@from.Title</button></li>
                }
                <li aria-current="page">@title</li>
            </ol>
            <span class="wb-sp"></span>
            @if (full)
            {
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="CloseFullDiagram">@Rich("flow.map.closeFull")</button>
            }
            else
            {
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="OpenFullDiagram">@Icon("dia")@Rich("flow.map.openFull")</button>
            }
            <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm wb-back" @onclick="CloseProcess">@Rich("flow.map.back")</button>
        </nav>;
    }

    private RenderFragment MapPanel(bool liveMode = false)
    {
        var map = Map;
        var legendId = idp + "-mapkey";
        var titleId = idp + "-map";
        return @<section class="wb-panel wb-mapview" aria-labelledby="@titleId">
            <div class="wb-ph">
                <h2 class="wb-title" id="@titleId">@Rich(liveMode ? "flow.cases.title" : "flow.map.title")</h2>
                <div class="wb-meta">@MapCountsLine()</div>
                @if (liveMode)
                {
                    @LiveHeader()
                }
                else
                {
                    <div class="wb-meta wb-small">@Rich("flow.map.note")</div>
                }
            </div>
            <div class="wb-body wb-mapbody">
                @if (!liveMode)
                {
                <details class="wb-mapkey" open="@(!Session.ProcessOpen)">
                    <summary class="wb-mapkey-t" id="@legendId">@Rich("flow.mapkey.title")</summary>
                    <dl class="wb-mapkey-l">
                        @foreach (var item in MapKey())
                        {
                            <div class="wb-mapkey-i"><dt class="@item.Tone">@Icon(item.Icon)@item.Word</dt><dd class="wb-meta">@item.Description</dd></div>
                        }
                    </dl>
                </details>
                }
                @if (!liveMode && map.Mains.Any(main => main.Starts.Count > 0))
                {
                    var startsId = idp + "-starts";
                    <section class="wb-lane" aria-labelledby="@startsId">
                        <h3 class="wb-lane-h" id="@startsId">@Rich("flow.map.lane.starts")</h3>
                        <ul class="wb-starts">
                            @foreach (var main in map.Mains)
                            {
                                @foreach (var start in main.Starts)
                                {
                                    <li class="wb-start">@Icon("ev")<span>@Sentence(start)</span><span class="wb-arr">@Icon("go")@Rich("flow.map.starts")</span><strong>@main.Process.Title</strong></li>
                                }
                            }
                        </ul>
                    </section>
                }
                @if (map.Mains.Count > 0)
                {
                    var mainsId = idp + "-mains";
                    <section class="wb-lane" aria-labelledby="@mainsId">
                        <h3 class="wb-lane-h" id="@mainsId">@KindsWord(FlowKind.Main)</h3>
                        @foreach (var main in map.Mains)
                        {
                            @MainFrame(main, liveMode)
                        }
                    </section>
                }
                @if (map.Scheduled.Count > 0)
                {
                    var scheduledId = idp + "-scheduled";
                    <section class="wb-lane" aria-labelledby="@scheduledId">
                        <h3 class="wb-lane-h" id="@scheduledId">@KindsWord(FlowKind.Scheduled)</h3>
                        <ul class="wb-lane-l">
                            @foreach (var task in map.Scheduled)
                            {
                                <li>@PlainCard(task.Process, task.Schedules, "wb-schc", liveMode, task.Children)</li>
                            }
                        </ul>
                    </section>
                }
                @if (map.Detached.Count > 0)
                {
                    var detachedId = idp + "-detached";
                    <section class="wb-lane" aria-labelledby="@detachedId">
                        <h3 class="wb-lane-h" id="@detachedId">@Rich("flow.map.lane.detached")</h3>
                        <ul class="wb-lane-l">
                            @foreach (var process in map.Detached)
                            {
                                <li>@PlainCard(process, [], "wb-schc", liveMode)</li>
                            }
                        </ul>
                    </section>
                }
                @foreach (var cycle in map.Cycles)
                {
                    <p class="wb-note">@Plain("flow.map.cycles", ("titles", string.Join(Plain("flow.join"), cycle.Select(TitleOfId))))</p>
                }
                @if (!liveMode && map.Shared.Count > 0)
                {
                    var sharedId = idp + "-shared";
                    <section class="wb-lane" aria-labelledby="@sharedId">
                        <h3 class="wb-lane-h" id="@sharedId">@Rich("flow.map.lane.shared")</h3>
                        <ul class="wb-chips wb-shared">
                            @foreach (var shared in map.Shared)
                            {
                                <li class="wb-shared-i">@UseChip(shared.Use)<span class="wb-meta">@Plain("flow.map.shared.used", ("n", Number(shared.Count)))</span></li>
                            }
                        </ul>
                    </section>
                }
            </div>
        </section>;
    }

    private RenderFragment MainFrame(MapMain main, bool liveMode = false)
    {
        var process = main.Process;
        var flow = FlowWithId(process.Id);
        var headingId = idp + "-m-" + process.Id;
        var openClass = "wb-card-btn wb-frame-btn" + (IsOpen(process.Id) ? " wb-sel" : string.Empty);
        return @<section class="wb-frame wb-k-main" aria-labelledby="@headingId">
            <header class="wb-frame-h">
                @KindMark(FlowKind.Main)
                <h4 class="wb-frame-t" id="@headingId">
                    @if (liveMode)
                    {
                        @process.Title
                    }
                    else
                    {
                        <button type="button" class="@openClass" aria-label="@CardName(process, flow)" aria-current="@(IsOpen(process.Id) ? "true" : null)" @onclick="() => OpenProcess(process.Id, null)">@process.Title</button>
                    }
                </h4>
                @if (liveMode)
                {
                    <span class="wb-sp"></span>
                    @CountButton(process.Id, process.Title, null, null)
                }
                else
                {
                    <span class="wb-meta">@MapFacts(process, flow)</span>
                    @if (process.NoStartDefined)
                    {
                        <span class="@PillClass("warn")">@Rich("flow.map.noStart")</span>
                    }
                    <span class="wb-sp"></span>
                    <button type="button" class="wb-link" @onclick="() => OpenProcess(process.Id, null, true)">@Icon("dia")@Rich("flow.map.seeDiagram")</button>
                }
            </header>
            @if (!liveMode)
            {
                @UsesBlock(process)
            }
            <ol class="@("wb-phases" + (main.Phases.Count > 4 ? " wb-many" : string.Empty))">
                @foreach (var phase in main.Phases)
                {
                    var number = main.Phases.ToList().IndexOf(phase) + 1;
                    <li class="wb-phase">
                        <div class="wb-phase-h">
                            <span class="wb-phase-t">@(phase.IsLoose ? Plain("flow.map.phase.none") : Number(number) + " · " + phase.Label)</span>
                            @if (phase.EndsWhen is not null)
                            {
                                <small class="wb-phase-e">@Sentence(phase.EndsWhen)</small>
                            }
                            @if (liveMode)
                            {
                                @CountButton(process.Id, process.Title, phase.StageId, phase.IsLoose ? Plain("flow.map.phase.none") : phase.Label)
                            }
                        </div>
                        @if (phase.Subprocesses.Count > 0)
                        {
                            <ul class="wb-cards">
                                @foreach (var child in phase.Subprocesses)
                                {
                                    <li class="wb-card-li">
                                        <div class="wb-stem" aria-hidden="true"><em>@Plain("flow.map.starts")</em></div>
                                        @SubCard(child, process.Id, liveMode)
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ol>
            @if (main.Ends.Count > 0)
            {
                <div class="wb-ends">
                    <span class="wb-meta">@Rich("flow.map.ends")</span>
                    <ul class="wb-end-l">
                        @foreach (var end in main.Ends)
                        {
                            <li class="wb-end">@end</li>
                        }
                    </ul>
                </div>
            }
        </section>;
    }

    private RenderFragment SubCard(MapChild child, string parentId, bool liveMode = false)
    {
        var process = child.Process;
        var flow = child.IsMissing ? null : FlowWithId(process.Id);
        var cardClass = "wb-card wb-k-sub" + (IsOpen(process.Id) ? " wb-sel" : string.Empty);
        return @<div class="@cardClass">
            @if (liveMode)
            {
                <span class="wb-card-btn">@KindMark(FlowKind.Subprocess)<span class="wb-card-t">@process.Title</span></span>
                @CountButton(process.Id, process.Title, null, null)
            }
            else if (flow is null)
            {
                <span class="wb-card-btn">@KindMark(FlowKind.Subprocess)<span class="wb-card-t">@process.Title</span><span class="wb-meta">@Plain("flow.map.notLoaded")</span></span>
            }
            else
            {
                <button type="button" class="wb-card-btn" aria-label="@CardName(process, flow)" aria-current="@(IsOpen(process.Id) ? "true" : null)" @onclick="() => OpenProcess(process.Id, parentId)">
                    @KindMark(FlowKind.Subprocess)
                    <span class="wb-card-t">@process.Title</span>
                    <span class="wb-meta">@MapFacts(process, flow)</span>
                </button>
            }
            @foreach (var other in child.AlsoStartedBy)
            {
                <span class="wb-meta wb-also">@Plain("flow.map.alsoStartedBy", ("title", other))</span>
            }
            @if (!liveMode)
            {
                @UsesBlock(process)
            }
            @NestedCards(child.Nested, process.Id, liveMode)
        </div>;
    }

    /// <summary>The subprocesses a subprocess or a scheduled task starts: the same cards, one level down, each behind the "starts" stem.</summary>
    private RenderFragment NestedCards(IReadOnlyList<MapChild> children, string parentId, bool liveMode) => children.Count == 0 ? @<text></text> : @<ul class="wb-cards wb-nested">
        @foreach (var nested in children)
        {
            <li class="wb-card-li">
                <div class="wb-stem" aria-hidden="true"><em>@Plain("flow.map.starts")</em></div>
                @SubCard(nested, parentId, liveMode)
            </li>
        }
    </ul>;

    /// <summary>A card of a process that sits in a lane of its own: a scheduled task with its schedule sentences, or a subprocess nothing reaches.</summary>
    private RenderFragment PlainCard(MapProcess process, IReadOnlyList<string> sentences, string laneClass, bool liveMode = false, IReadOnlyList<MapChild>? children = null)
    {
        var flow = FlowWithId(process.Id);
        var cardClass = laneClass + " " + KindTone(process.Kind) + (IsOpen(process.Id) ? " wb-sel" : string.Empty);
        return @<div class="@cardClass">
            @if (liveMode)
            {
                <span class="wb-card-btn">@KindMark(process.Kind)<span class="wb-card-t">@process.Title</span></span>
                @CountButton(process.Id, process.Title, null, null)
            }
            else
            {
                <button type="button" class="wb-card-btn" aria-label="@CardName(process, flow)" aria-current="@(IsOpen(process.Id) ? "true" : null)" @onclick="() => OpenProcess(process.Id, null)">
                    @KindMark(process.Kind)
                    <span class="wb-card-t">@process.Title</span>
                    <span class="wb-meta">@MapFacts(process, flow)</span>
                </button>
            }
            @foreach (var sentence in sentences)
            {
                <span class="wb-meta">@Sentence(sentence)</span>
            }
            @if (!liveMode)
            {
                @UsesBlock(process)
            }
            @NestedCards(children ?? [], process.Id, liveMode)
        </div>;
    }

    // ----- the live view ----------------------------------------------------------------------------------------------

    private RenderFragment LiveLayout()
    {
        var caseOpen = Session.LiveCaseRef is not null;
        var listOpen = !caseOpen && Session.LiveScopeProcessId is not null;
        var layoutClass = "wb-mapgrid" + (listOpen ? " wb-open" : string.Empty) + (caseOpen ? " wb-full" : string.Empty);
        return @<div class="@layoutClass">
            @if (caseOpen)
            {
                @CasePanel()
            }
            else
            {
                @MapPanel(true)
                @if (listOpen)
                {
                    @CasesPanel()
                }
            }
        </div>;
    }

    private RenderFragment LiveHeader()
    {
        var overlay = Overlay;
        return @<div class="wb-live-bar">
            <div class="wb-meta wb-small">@Rich("flow.cases.note")</div>
            <div class="wb-live-row">
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@liveLoading" @onclick="RetryAsync">@Rich("flow.cases.refresh")</button>
                <span class="wb-meta wb-live-status" role="status">
                    @if (liveLoading)
                    {
                        @Rich(overlay is null ? "flow.cases.loading" : "flow.cases.updating")
                    }
                    else if (overlay is not null && overlay.Total.IsZero)
                    {
                        @Rich("flow.cases.empty")
                    }
                    else if (overlay is not null)
                    {
                        @PluralText("flow.cases.total", overlay.Total.Open)
                    }
                </span>
            </div>
            @if (liveFailed)
            {
                <p class="wb-note wb-live-fail" role="alert">@Rich(overlay is null ? "flow.cases.failed.none" : "flow.cases.failed")</p>
            }
            @if (overlay is { Unplaced.IsZero: false })
            {
                <p class="wb-meta">@PluralText("flow.cases.unplaced", overlay.Unplaced.Open)</p>
            }
            @if (overlay is { IsPartial: true })
            {
                <p class="wb-meta">@Rich("flow.cases.partial")</p>
            }
        </div>;
    }

    /// <summary>The number of open cases of a process or of one of its phases, as a button that lists them; plain words when there are none, nothing before the numbers arrive.</summary>
    private RenderFragment CountButton(string processId, string title, string? stageId, string? phaseLabel)
    {
        var overlay = Overlay;
        if (overlay is null)
        {
            return @<text></text>;
        }

        var phase = phaseLabel is not null;
        var count = phase ? overlay.Phase(processId, stageId) : overlay.Process(processId);
        if (count.IsZero)
        {
            return @<span class="wb-meta wb-live-none">@Plain("flow.cases.count.none")</span>;
        }

        var line = LiveCountsLine(count);
        var name = phase
            ? Plain("flow.cases.count.phase", ("phase", phaseLabel!), ("title", title), ("counts", line))
            : Plain("flow.cases.count.process", ("title", title), ("counts", line));
        var chosen = string.Equals(Session.LiveScopeProcessId, processId, StringComparison.Ordinal)
            && (phase ? string.Equals(Session.LiveScopeStageId, stageId ?? string.Empty, StringComparison.Ordinal) : Session.LiveScopeStageId is null);
        var buttonClass = "wb-live-btn" + (chosen ? " wb-sel" : string.Empty);
        return @<button type="button" class="@buttonClass" aria-label="@name" aria-current="@(chosen ? "true" : null)" @onclick="() => OpenCasesAsync(processId, stageId, phase)">@line</button>;
    }

    private string PhaseName(string processId, string scope) =>
        scope.Length == 0
            ? Plain("flow.map.phase.none")
            : Map.Mains.Where(main => main.Process.Id == processId).SelectMany(main => main.Phases).FirstOrDefault(phase => phase.StageId == scope)?.Label ?? scope;

    private RenderFragment CasesPanel()
    {
        var processId = Session.LiveScopeProcessId!;
        var scope = Session.LiveScopeStageId;
        var title = TitleOfId(processId);
        var heading = scope is null
            ? Plain("flow.cases.list.title", ("title", title))
            : Plain("flow.cases.list.titlePhase", ("title", title), ("phase", PhaseName(processId, scope)));
        var headingId = idp + "-cases";
        return @<section class="wb-panel wb-detail wb-side" aria-labelledby="@headingId">
            <div class="wb-ph wb-cases-h">
                <h2 class="wb-title" id="@headingId">@heading</h2>
                <span class="wb-sp"></span>
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="CloseCases">@Rich("flow.cases.list.close")</button>
            </div>
            <div class="wb-body">
                @if (listFailed)
                {
                    <p class="wb-note wb-live-fail" role="alert">@Rich("flow.cases.list.failed") <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="RetryAsync">@Rich("flow.cases.retry")</button></p>
                }
                else if (listLoading && listCases.Count == 0)
                {
                    <p class="wb-sub" role="status">@Rich("flow.cases.list.loading")</p>
                }
                else if (listCases.Count == 0)
                {
                    <p class="wb-sub" role="status">@Rich(listNext is null ? "flow.cases.list.empty" : "flow.cases.list.noneYet")</p>
                }

                <ul class="wb-caselist" aria-label="@Plain("flow.cases.list.label")">
                    @foreach (var line in listCases)
                    {
                        var caseRef = line.CaseRef;
                        var facts = LineFacts(line, processId);
                        <li>
                            <button type="button" class="wb-caseline" aria-label="@Plain("flow.cases.line.open", ("ref", caseRef), ("facts", facts))" @onclick="() => OpenCaseAsync(caseRef)">
                                <span class="wb-caseref">@Weave("flow.cases.line.ref", [], ("ref", caseRef))</span>
                                <span class="wb-meta">@facts</span>
                            </button>
                        </li>
                    }
                </ul>
                @if (listNext is not null && !listFailed)
                {
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@listLoading" @onclick="MoreCasesAsync">@Rich("flow.cases.list.more")</button>
                }
            </div>
        </section>;
    }

    private RenderFragment CasePanel()
    {
        var caseRef = Session.LiveCaseRef!;
        var titleId = idp + "-case";
        return @<section class="wb-panel" aria-labelledby="@titleId">
            <div class="wb-ph wb-cases-h">
                <h2 class="wb-title" id="@titleId">@Plain("flow.cases.case.title", ("ref", caseRef))</h2>
                <span class="wb-sp"></span>
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@(liveLoading || caseLoading)" @onclick="RetryAsync">@Rich("flow.cases.refresh")</button>
                @if (Session.LiveScopeProcessId is not null)
                {
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="CloseCase">@Rich("flow.cases.case.back")</button>
                }
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="CloseCases">@Rich("flow.cases.case.backMap")</button>
            </div>
            <div class="wb-body">
                @if (caseFailed)
                {
                    <p class="wb-note wb-live-fail" role="alert">@Rich("flow.cases.case.failed") <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="RetryAsync">@Rich("flow.cases.retry")</button></p>
                }
                else if (caseLoading)
                {
                    <p class="wb-sub" role="status">@Rich("flow.cases.case.loading")</p>
                }
                else if (caseGone)
                {
                    <p class="wb-sub" role="status">@Rich("flow.cases.case.gone")</p>
                }
                else if (caseData is { } live)
                {
                    @CaseBody(live, caseRef)
                }
            </div>
        </section>;
    }

    private RenderFragment CaseBody(FlowLiveCase live, string caseRef)
    {
        if (CaseFlow(live) is not { } flow || Data(flow) is not { } d || CasePath is not { } path)
        {
            return @<p class="wb-note" role="note">@Plain("flow.cases.case.noProcess", ("id", live.ProcessId))</p>;
        }

        var layout = d.LayoutFor(Plain("flow.read.noStage"));
        return @<text>
            <p class="wb-meta">@Plain("flow.cases.case.process", ("title", d.Entry.Title), ("version", Number(live.ProcessVersion)))</p>
            @if (!path.IsExplained)
            {
                <p class="wb-note" role="note">@Plain("flow.cases.case.unexplained", ("reason", WithoutCode(path.Reason ?? string.Empty)))</p>
            }
            else
            {
                <p class="wb-meta wb-small">@Rich("flow.cases.case.hint")</p>
                <div class="wb-case-layout" role="group" aria-label="@Plain("flow.cases.case.label")">
                    <div class="wb-case-main">
                        <div class="wb-diagram-scroll" role="region" aria-label="@Plain("flow.diagram.scroll")" tabindex="0">
                            @DiagramSvg(d, layout, null, path, caseRef)
                        </div>
                        <ul class="wb-legend-list wb-case-legend">
                            <li>
                                <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><rect class="wb-node-shape wb-node-seen-sample" x="2" y="2" width="48" height="24" rx="6"></rect><circle class="wb-seen-badge" cx="12" cy="19" r="7"></circle>@SvgText(12, 19, "wb-seen-badge-t", "1")</svg>
                                <span>@Rich("flow.cases.legend.visited")</span>
                            </li>
                            <li>
                                <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><rect class="wb-node-shape wb-node-now-sample" x="2" y="2" width="48" height="24" rx="6"></rect><circle class="wb-node-here" cx="38" cy="9" r="6"></circle></svg>
                                <span>@Rich("flow.cases.legend.here")</span>
                            </li>
                            <li>
                                <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><line class="wb-edge wb-edge-taken" x1="2" y1="14" x2="50" y2="14"></line></svg>
                                <span>@Rich("flow.cases.legend.taken")</span>
                            </li>
                        </ul>
                    </div>
                    <aside class="wb-case-side" aria-label="@Plain("flow.cases.side.label")">
                        <dl class="wb-facts">
                            <dt>@Rich("flow.cases.side.step")</dt>
                            <dd>@(path.Side?.CurrentStep ?? Plain("flow.cases.side.none"))</dd>
                            <dt>@Rich("flow.cases.side.why")</dt>
                            <dd>@(path.Side?.Why is { } why ? Sentence(why) : Rich("flow.cases.side.none"))</dd>
                            <dt>@Rich("flow.cases.side.waits")</dt>
                            <dd>@(path.Waiting is { } waits ? Sentence(waits) : Rich("flow.cases.side.none"))</dd>
                            <dt>@Rich("flow.cases.side.next")</dt>
                            <dd>
                                @if (path.Side is { Next.Count: > 0 } side)
                                {
                                    <ul class="wb-next">
                                        @foreach (var phrase in side.Next)
                                        {
                                            <li>@Sentence(phrase)</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    @Rich("flow.cases.side.none")
                                }
                            </dd>
                            <dt>@Rich("flow.cases.side.version")</dt>
                            <dd>@Number(live.ProcessVersion)</dd>
                        </dl>
                    </aside>
                </div>
                <section class="wb-casepath" aria-labelledby="@(idp + "-path")">
                    <h3 class="wb-h2" id="@(idp + "-path")">@Rich("flow.cases.path.title")</h3>
                    @if (path.Steps.Count == 0)
                    {
                        <p class="wb-sub">@Rich("flow.cases.path.empty")</p>
                    }
                    else
                    {
                        <ol class="wb-casepath-list">
                            @foreach (var visited in path.Steps)
                            {
                                <li>
                                    <strong>@visited.Label</strong>
                                    @if (visited.Times > 1)
                                    {
                                        <span class="wb-meta">@Plain("flow.cases.path.times", ("n", Number(visited.Times)))</span>
                                    }
                                    @if (visited.IsCurrent)
                                    {
                                        <span class="@PillClass("sim")">@Rich("flow.cases.path.here")</span>
                                    }
                                    else if (visited.Left is { } left)
                                    {
                                        <span class="wb-meta">@Plain("flow.cases.path.left", ("phrase", WithoutCode(left)))</span>
                                    }
                                </li>
                            }
                        </ol>
                    }
                </section>
            }
        </text>;
    }

    private string LiveNodeLabel(FlowNode node, FlowFamily family, bool current, int order)
    {
        var parts = new List<string> { node.Label, FamilyWord(family) };
        if (node.IsStart)
        {
            parts.Add(Plain("flow.family.start"));
        }

        if (order > 0)
        {
            parts.Add(Plain("flow.cases.node.visited", ("n", Number(order))));
        }

        if (current)
        {
            parts.Add(Plain("flow.diagram.here"));
        }

        return string.Join(Plain("flow.join.label"), parts);
    }

    private RenderFragment UsesBlock(MapProcess process) => process.Uses.Count == 0 ? @<text></text> : @<div class="wb-uses">
        <span class="wb-meta">@Rich("flow.map.uses")</span>
        <ul class="wb-chips">
            @foreach (var use in process.Uses)
            {
                <li>@UseChip(use)</li>
            }
        </ul>
    </div>;

    /// <summary>A rule, connector, queue or AI step a process uses: its icon, its label and, for a rule the host gave an authority label, the badge. A rule is a link only when the host handles <c>OnOpenRule</c>.</summary>
    private RenderFragment UseChip(MapUse use)
    {
        var chipClass = "wb-chip " + PieceTone(use.Kind);
        var badge = AuthorityBadge(use);
        var link = use.Kind == MapPieceKind.Rule && OnOpenRule.HasDelegate;
        return @<span class="@chipClass">
            @Icon(PieceIcon(use.Kind))
            <span class="wb-sr">@(PieceWord(use.Kind) + ": ")</span>
            @if (link)
            {
                <button type="button" class="wb-chip-btn" aria-label="@Plain("flow.map.rule.open", ("label", use.Label))" @onclick="() => OpenRule(use.Name)">@UseLabel(use)</button>
            }
            else
            {
                @UseLabel(use)
            }
            @if (badge is not null)
            {
                <span class="wb-badge" title="@Plain("flow.map.authority", ("label", badge))">@badge</span>
            }
        </span>;
    }

    private static RenderFragment UseLabel(MapUse use) => use.LabelIsName ? Code(use.Label) : @<text>@use.Label</text>;

    private RenderFragment PrivacyNotice() => @<div class="wb-notice" role="note">@Rich("notice.privacy")</div>;

    private RenderFragment Band(string key) => @<div class="wb-band"><span class="@PillClass("sim")">@Rich("pill.simulation")</span><span>@Rich(key)</span></div>;

    private RenderFragment DetailPanel(WorkbenchFlow flow)
    {
        var d = Data(flow);
        if (d is null)
        {
            return @<text>
                <div class="wb-ph">
                    <div class="wb-head"><h1 class="wb-title">@TitleOf(flow)</h1><span class="@PillClass("neutral")">@Rich("flow.list.unreadable")</span></div>
                </div>
                <div class="wb-body wb-sub" role="status">@Rich("flow.load.failedBody")</div>
            </text>;
        }

        var work = Session.Work(flow.Key);
        var current = Session.SelectedTab;
        var marked = TargetsOf(d, work).Count(target => work.Review(target).State != ReviewState.Unreviewed);
        var failing = d.Scenarios.Count(line => !line.Passed);

        return @<text>
            <div class="wb-ph">
                <div class="wb-head">
                    @KindMark(d.Entry.Kind)
                    <h1 class="wb-title">@d.Entry.Title</h1>
                    <span class="wb-sp"></span>
                    <span class="wb-meta">@Rich("flow.panel.version", ("n", Number(d.Outline.Version)))</span>
                </div>
                <div class="wb-meta">@if (!string.IsNullOrWhiteSpace(flow.StateLine)){@flow.StateLine}@if (!string.IsNullOrWhiteSpace(flow.SourceLine)){@(" " + flow.SourceLine)}</div>
                <div class="wb-meta wb-small">@Rich("flow.state.elsewhere")</div>
            </div>
            <div class="wb-tabs" role="tablist" aria-label="@Plain("flow.tabs.label")">
                @for (var number = 0; number < TabKeys.Length; number++)
                {
                    var tab = (FlowWorkbenchTab)number;
                    var index = number;
                    var on = tab == current;
                    <button type="button" role="tab" id="@(idp + "-tab-" + number)" class="wb-tab" aria-selected="@(on ? "true" : "false")" aria-controls="@(idp + "-panel")" tabindex="@(on ? 0 : -1)" @onclick="() => SelectTab(tab)" @onkeydown="OnTabKeyDown" @ref="refs[TabRef(index)]">
                        @{ Seen(TabRef(index)); }
                        @Rich(TabKeys[number])
                        @if (tab == FlowWorkbenchTab.Tests && failing > 0)
                        {
                            <span class="wb-pill wb-pill-n wb-pill-bad">@PluralText("fail.count", failing)</span>
                        }
                        else if (tab == FlowWorkbenchTab.Tests && d.Scenarios.Count > 0)
                        {
                            <span class="wb-pill wb-pill-n">@Number(d.Scenarios.Count)</span>
                        }
                        @if (tab == FlowWorkbenchTab.Review && marked > 0)
                        {
                            <span class="wb-pill wb-pill-n">@Number(marked)</span>
                        }
                    </button>
                }
            </div>
            <div class="wb-body" role="tabpanel" id="@(idp + "-panel")" aria-labelledby="@(idp + "-tab-" + (int)current)" tabindex="0">
                @switch (current)
                {
                    case FlowWorkbenchTab.Read:
                        @ReadPanel(d, work)
                        break;
                    case FlowWorkbenchTab.Diagram:
                        @DiagramPanel(d, work)
                        break;
                    case FlowWorkbenchTab.Try:
                        @TryPanel(d, work)
                        break;
                    case FlowWorkbenchTab.Tests:
                        @TestsPanel(d, work)
                        break;
                    default:
                        @ReviewPanel(d, work)
                        break;
                }
            </div>
        </text>;
    }

    // ----- shared pieces ----------------------------------------------------------------------------------------------

    private RenderFragment ReviewControl(FlowWork work, string target, string groupLabel) => @<div class="wb-rv" role="group" aria-label="@groupLabel">
        @foreach (var part in ReviewParts)
        {
            var state = part.State;
            var pressed = work.Review(target).State == state;
            <button type="button" class="wb-seg-part" aria-pressed="@(pressed ? "true" : "false")" @onclick="() => ToggleReview(work, target, state)">@Rich(pressed ? part.PressedKey : part.Key)</button>
        }
    </div>;

    /// <summary>The word "needs a note" for a flow that has a fix or a question with no note, after the review line of the list.</summary>
    private RenderFragment NeedsNotePill(WorkbenchFlow flow, FlowData d) =>
        NeedsNote(flow, d) ? @<text>@(" ")<span class="@PillClass("warn")">@Rich("flow.list.needsNote")</span></text> : @<text></text>;

    private RenderFragment MissingNote(FlowWork work, string target) => @<span class="wb-missing-note"><span class="wb-missing">@Rich("flow.review.noteMissing")</span> <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => OpenNote(work, target)">@Rich("flow.review.writeNote")</button></span>;

    private RenderFragment NoteEditor(FlowWork work, string target, string? aboutName = null)
    {
        var entry = work.Review(target);
        if (aboutName is null && !NoteVisible(work, target))
        {
            return entry.State == ReviewState.Confirmed
                ? @<button type="button" class="wb-link" @onclick="() => OpenNote(work, target)">@Rich("flow.review.addNote")</button>
                : @<text></text>;
        }

        var id = NoteId(target);
        return @<div class="wb-card wb-note">
            <label class="@(aboutName is null ? "wb-label" : "wb-sr")" for="@id">@(aboutName is null ? Plain("flow.review.noteLabel") : Plain("flow.review.noteFor", ("name", aboutName)))</label>
            @{ Seen(NoteRef(target)); }
            <textarea id="@id" class="wb-in" rows="2" maxlength="@NoteMax" value="@entry.Note" @onchange="args => SetNote(work, target, args.Value?.ToString())" @ref="refs[NoteRef(target)]"></textarea>
            @if (entry.Note.Length >= NoteCounterFrom)
            {
                <div class="wb-hint">@Plain("flow.review.counter", ("n", Number(entry.Note.Length)), ("max", Number(NoteMax)))</div>
            }
        </div>;
    }

    // ----- Read -------------------------------------------------------------------------------------------------------

    private RenderFragment ReadPanel(FlowData d, FlowWork work)
    {
        var entry = d.Entry;
        var loose = d.View.Steps.Where(step => step.Stage is null).ToList();
        return @<text>
            <div class="wb-card wb-card-gap">
                <div class="wb-card-head">
                    <h2 class="wb-h2 wb-h2-flush">@Rich("flow.read.startsHeading")</h2>
                    <span class="wb-sp"></span>
                    @ReviewControl(work, "process", Plain("flow.review.groupFlow"))
                </div>
                @if (entry.Triggers.Count > 0)
                {
                    <ul class="wb-routes">
                        @for (var position = 0; position < entry.Triggers.Count; position++)
                        {
                            var trigger = entry.Triggers[position];
                            var triggerTarget = position < d.TriggerIds.Count ? FlowReviewTargets.Trigger(d.TriggerIds[position]) : null;
                            <li class="wb-route">
                                <span class="wb-route-t">@Sentence(trigger)</span>
                                @if (triggerTarget is not null)
                                {
                                    @ReviewControl(work, triggerTarget, Plain("flow.review.groupTrigger", ("name", WithoutCode(trigger))))
                                    @NoteEditor(work, triggerTarget)
                                }
                            </li>
                        }
                    </ul>
                }
                else if (entry.StartedBy.Count > 0)
                {
                    <div class="wb-sub">@Sentence(Plain("flow.list.startedBy", ("title", string.Join(Plain("flow.join"), entry.StartedBy.Select(TitleOfId)))))</div>
                }
                else
                {
                    <div class="wb-sub">@Rich("flow.list.startedByHost")</div>
                }
                @NoteEditor(work, "process")
                <dl class="wb-kv">
                    <dt>@Rich("flow.read.rules")</dt>
                    <dd>@if (entry.Rules.Count == 0){@Rich("flow.read.noRules")}else{@foreach (var rule in entry.Rules){@Code(rule)@(" ")}}</dd>
                    <dt>@Rich("flow.read.children")</dt>
                    <dd>
                        @if (entry.Children.Count == 0)
                        {
                            @Rich("flow.read.none")
                        }
                        else
                        {
                            @foreach (var child in entry.Children)
                            {
                                var target = child.IsMissing ? null : FlowWithId(child.ProcessId);
                                @if (target is not null)
                                {
                                    <button type="button" class="wb-link" @onclick="() => SelectFlow(target.Key)">@child.Title</button>
                                }
                                else
                                {
                                    @Code(child.ProcessId)
                                    <span class="wb-sub"> @Rich("flow.read.childMissing")</span>
                                }
                                @(" ")
                            }
                        }
                    </dd>
                </dl>
            </div>
            @foreach (var stage in d.View.Stages)
            {
                var stageTarget = "stage:" + stage.Id;
                var steps = d.View.Steps.Where(step => step.Stage == stage.Id).ToList();
                <section class="wb-flow-stage" aria-labelledby="@(idp + "-stage-" + stage.Id)">
                    <div class="wb-card-head">
                        <h2 class="wb-h2 wb-h2-flush" id="@(idp + "-stage-" + stage.Id)">@stage.Label</h2>
                        <span class="wb-sp"></span>
                        @ReviewControl(work, stageTarget, Plain("flow.review.groupStage", ("name", stage.Label)))
                    </div>
                    @NoteEditor(work, stageTarget)
                    @foreach (var step in steps)
                    {
                        @StepBody(d, work, step, false)
                    }
                </section>
            }
            @if (loose.Count > 0)
            {
                <section class="wb-flow-stage" aria-labelledby="@(idp + "-stage-none")">
                    <h2 class="wb-h2" id="@(idp + "-stage-none")">@Rich("flow.read.noStage")</h2>
                    @foreach (var step in loose)
                    {
                        @StepBody(d, work, step, false)
                    }
                </section>
            }
        </text>;
    }

    /// <summary>One step as the Read tab and the card of the diagram show it.</summary>
    private RenderFragment StepBody(FlowData d, FlowWork work, FlowStepView step, bool inCard)
    {
        var target = "step:" + step.Id;
        var start = d.Outline.Start == step.Id;
        return @<section class="wb-step" @key="step.Id" id="@(idp + "-step-" + step.Id)" tabindex="-1" aria-labelledby="@(idp + "-step-t-" + step.Id)" @ref="refs[StepRef(step.Id)]">
            @{ Seen(StepRef(step.Id)); }
            <div class="wb-card-head">
                <h3 class="wb-step-t" id="@(idp + "-step-t-" + step.Id)">@step.Label</h3>
                <span class="@PillClass("neutral")">@step.KindName</span>
                @if (start)
                {
                    <span class="@PillClass("ok")">@Rich("flow.read.start")</span>
                }
                <span class="wb-sp"></span>
                @ReviewControl(work, target, Plain("flow.review.groupStep", ("name", step.Label)))
            </div>
            <p class="wb-sent wb-flow-sentence">@Sentence(step.Sentence)</p>
            @NoteEditor(work, target)
            @if (step.Routes.Count > 0)
            {
                <ul class="wb-routes" aria-label="@Plain("flow.read.routes", ("name", step.Label))">
                    @foreach (var route in step.Routes)
                    {
                        var routeTarget = FlowData.RouteTarget(step.Id, route.Label);
                        var untried = d.Untried.Contains(step.Id + "/" + route.Label);
                        var go = route.Target;
                        <li class="wb-route">
                            <span class="wb-route-t">@Sentence(route.Stem)<button type="button" class="wb-link wb-route-go" @onclick="() => FollowRoute(inCard, go)">@route.TargetLabel</button>
                                @if (untried)
                                {
                                    <span class="@PillClass("warn")">@Rich("flow.read.untried")</span>
                                }
                            </span>
                            @ReviewControl(work, routeTarget, Plain("flow.review.groupRoute", ("phrase", WithoutCode(route.Phrase))))
                            @NoteEditor(work, routeTarget)
                        </li>
                    }
                </ul>
            }
            @if (step.Ai is { } ai)
            {
                @AiBlock(ai)
            }
        </section>;
    }

    private RenderFragment AiBlock(FlowAiView ai)
    {
        var fields = FlowSchemaFields.From(ai.OutputSchemaJson);
        return @<div class="wb-card wb-ai">
            <h4 class="wb-h2 wb-h2-flush">@Rich("flow.ai.title")</h4>
            <dl class="wb-kv">
                <dt>@Rich("flow.ai.model")</dt>
                <dd>@Code(ai.Model)</dd>
                <dt>@Rich("flow.ai.prompt")</dt>
                <dd>@Code(ai.PromptId) @Plain("flow.ai.version", ("n", Number(ai.PromptVersion)))</dd>
                <dt>@Rich("flow.ai.attempts")</dt>
                <dd>@Number(ai.MaxAttempts)</dd>
                <dt>@Rich("flow.ai.goesIn")</dt>
                <dd>@if (ai.InputNames.Count == 0){@Rich("flow.read.none")}else{@foreach (var name in ai.InputNames){@Code(name)@(" ")}}</dd>
                <dt>@Rich("flow.ai.comesOut")</dt>
                <dd>
                    @if (fields.Count == 0)
                    {
                        @Rich("flow.read.none")
                    }
                    else
                    {
                        <ul class="wb-flow-list">
                            @foreach (var field in fields)
                            {
                                <li>@Code(field.Name) @Plain("flow.ai.field", ("type", TypeWord(field.Type)), ("required", field.IsRequired ? Plain("flow.ai.required") : Plain("flow.ai.optional")))</li>
                            }
                        </ul>
                    }
                </dd>
                @if (ai.OutputNames.Count > 0)
                {
                    <dt>@Rich("flow.ai.keeps")</dt>
                    <dd>@foreach (var name in ai.OutputNames){@Code(name)@(" ")}</dd>
                }
                @if (ai.JudgingRule is { } rule)
                {
                    <dt>@Rich("flow.ai.judged")</dt>
                    <dd>@Code(rule)</dd>
                }
                @if (ai.OnInvalid is { } invalid)
                {
                    <dt>@Rich("flow.ai.onInvalid")</dt>
                    <dd>@Sentence(invalid.Phrase)</dd>
                }
                @if (ai.OnError is { } error)
                {
                    <dt>@Rich("flow.ai.onError")</dt>
                    <dd>@Sentence(error.Phrase)</dd>
                }
                @if (ai.OnNotAvailable is { } unavailable)
                {
                    <dt>@Rich("flow.ai.onNotAvailable")</dt>
                    <dd>@Sentence(unavailable.Phrase)</dd>
                }
                @if (ai.OnNotEntitled is { } entitled)
                {
                    <dt>@Rich("flow.ai.onNotEntitled")</dt>
                    <dd>@Sentence(entitled.Phrase)</dd>
                }
            </dl>
            @if (ai.Notes.Count > 0)
            {
                <ul class="wb-flow-list">
                    @foreach (var note in ai.Notes)
                    {
                        <li>@Sentence(note)</li>
                    }
                </ul>
            }
        </div>;
    }

    // ----- Diagram ----------------------------------------------------------------------------------------------------

    private static string FamilyKey(FlowFamily family) => family.ToString().ToLowerInvariant();

    private static readonly FlowFamily[] LegendFamilies = [FlowFamily.Action, FlowFamily.Decision, FlowFamily.Person, FlowFamily.Ai, FlowFamily.Wait, FlowFamily.Flow, FlowFamily.End];

    private static string Px(int value) => value.ToString(CultureInfo.InvariantCulture);

    private static RenderFragment SvgText(int x, int y, string cssClass, string content, string anchor = "middle") => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "x", Px(x));
        builder.AddAttribute(2, "y", Px(y));
        builder.AddAttribute(3, "class", cssClass);
        builder.AddAttribute(4, "text-anchor", anchor);
        builder.AddAttribute(5, "dominant-baseline", "central");
        builder.AddContent(6, content);
        builder.CloseElement();
    };

    private static string Points(params int[] numbers) =>
        string.Join(' ', Enumerable.Range(0, numbers.Length / 2).Select(index => Px(numbers[2 * index]) + "," + Px(numbers[(2 * index) + 1])));

    private static RenderFragment NodeShape(FlowFamily family, int x, int y, int w, int h)
    {
        var right = x + w;
        var bottom = y + h;
        var middle = y + (h / 2);
        return family switch
        {
            FlowFamily.Ai => @<g>
                <rect class="wb-node-shape" x="@Px(x)" y="@Px(y)" width="@Px(w)" height="@Px(h)" rx="2"></rect>
                <rect class="wb-node-fold" x="@Px(x + 4)" y="@Px(y + 4)" width="@Px(w - 8)" height="@Px(h - 8)" rx="1"></rect>
            </g>,
            FlowFamily.Decision => @<polygon class="wb-node-shape" points="@Points(x + 22, y, right - 22, y, right, middle, right - 22, bottom, x + 22, bottom, x, middle)"></polygon>,
            FlowFamily.Person => @<g>
                <polygon class="wb-node-shape" points="@Points(x, y, right - 14, y, right, y + 14, right, bottom, x, bottom)"></polygon>
                <polyline class="wb-node-fold" points="@Points(right - 14, y, right - 14, y + 14, right, y + 14)"></polyline>
            </g>,
            FlowFamily.Wait => @<ellipse class="wb-node-shape" cx="@Px(x + (w / 2))" cy="@Px(middle)" rx="@Px(w / 2)" ry="@Px(h / 2)"></ellipse>,
            FlowFamily.Flow => @<g>
                <rect class="wb-node-shape" x="@Px(x)" y="@Px(y)" width="@Px(w)" height="@Px(h)" rx="6"></rect>
                <line class="wb-node-fold" x1="@Px(x + 9)" y1="@Px(y)" x2="@Px(x + 9)" y2="@Px(bottom)"></line>
                <line class="wb-node-fold" x1="@Px(right - 9)" y1="@Px(y)" x2="@Px(right - 9)" y2="@Px(bottom)"></line>
            </g>,
            FlowFamily.End => @<rect class="wb-node-shape wb-node-end" x="@Px(x)" y="@Px(y)" width="@Px(w)" height="@Px(h)" rx="@Px(h / 2)"></rect>,
            _ => @<rect class="wb-node-shape" x="@Px(x)" y="@Px(y)" width="@Px(w)" height="@Px(h)" rx="6"></rect>,
        };
    }

    /// <summary>The symbol of a step, the same the map draws for the piece the step uses; none for an end step.</summary>
    private static (string Symbol, string Tone)? NodeSymbol(FlowFamily family) => family switch
    {
        FlowFamily.Action => ("con", "wb-k-con"),
        FlowFamily.Decision => ("rule", "wb-k-rule"),
        FlowFamily.Person => ("per", "wb-k-per"),
        FlowFamily.Ai => ("ai", "wb-k-ai"),
        FlowFamily.Wait => ("sch", "wb-k-sch"),
        FlowFamily.Flow => ("sub", "wb-k-sub"),
        _ => null,
    };

    private const int NodeIconSize = 15;

    /// <summary>How far to the right of the middle of a step its text is written, to leave room for the symbol.</summary>
    private static int TextShift(FlowFamily family) => DiagramLayout.TextShift(family);

    private RenderFragment NodeIcon(FlowFamily family, int x, int y, int height) => builder =>
    {
        if (NodeSymbol(family) is not { } symbol)
        {
            return;
        }

        builder.OpenElement(0, "use");
        builder.AddAttribute(1, "class", "wb-node-i " + symbol.Tone);
        builder.AddAttribute(2, "href", "#" + idp + "-i-" + symbol.Symbol);
        builder.AddAttribute(3, "x", Px(x + 9));
        builder.AddAttribute(4, "y", Px(y + ((height - NodeIconSize) / 2)));
        builder.AddAttribute(5, "width", Px(NodeIconSize));
        builder.AddAttribute(6, "height", Px(NodeIconSize));
        builder.CloseElement();
    };

    private static string EdgeClass(DrawnLine line)
    {
        if (line.IsReturn)
        {
            return "wb-edge wb-edge-side wb-edge-return";
        }

        return line.IsHappyPath ? "wb-edge" : "wb-edge wb-edge-side";
    }

    private static int LineOffset(int lines, int position) => DiagramLayout.LineOffset(lines, position);

    private string FamilyWord(FlowFamily family) => Plain("flow.family." + FamilyKey(family));

    private static string? TryStepId(FlowWork work) =>
        work.Frames.Count > 0 && work.Frames[0].Simulation.Status is ProcessStatus.Waiting or ProcessStatus.Suspended or ProcessStatus.Running
            ? work.Frames[0].Simulation.CurrentStep
            : null;

    /// <summary>The SVG of a diagram. With <paramref name="live"/> it is the diagram of one case: the nodes are not buttons, the steps the case went through have a number and a thick border, the one it is on has an arrow, and the routes it took are thick.</summary>
    private RenderFragment DiagramSvg(FlowData d, DiagramLayout layout, string? here, LiveCasePath? live, string? caseRef = null)
    {
        var boxes = layout.Nodes.ToDictionary(box => box.Id, StringComparer.Ordinal);
        var arrow = idp + "-arrow";
        var width = Px(layout.Width);
        var height = Px(layout.Height);
        return @<text>
    <svg class="wb-diagram-svg" width="@width" height="@height" viewBox="0 0 @width @height" role="group" aria-label="@(live is null ? Plain("flow.diagram.label", ("title", d.Entry.Title)) : Plain("flow.cases.diagram.label", ("ref", caseRef ?? string.Empty), ("title", d.Entry.Title)))">
        <defs>
            <marker id="@arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" class="wb-arrow"></path>
            </marker>
            <marker id="@(arrow + "-taken")" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="16" markerHeight="16" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" class="wb-arrow wb-arrow-taken"></path>
            </marker>
        </defs>
        @foreach (var band in layout.Bands)
        {
            <g class="wb-band-g">
                <rect class="wb-band-bg" x="0" y="@Px(band.Y)" width="@width" height="@Px(band.Height)"></rect>
                @SvgText(band.LabelX, band.LabelY, "wb-band-t", band.IsLoose ? Plain("flow.read.noStage") : d.View.Stages[band.Index].Label, "start")
            </g>
        }
        @foreach (var line in layout.Lines)
        {
            var lineClass = EdgeClass(line) + (live is not null && live.TakenPairs.Contains((line.From, line.To)) ? " wb-edge-taken" : string.Empty);
            var phrases = string.Join("\n", line.Routes.Select(route => WithoutCode(route.Phrase)));
            <g class="wb-edge-g">
                <path class="@lineClass" d="@line.Path" marker-end="@("url(#" + arrow + (lineClass.Contains("wb-edge-taken", StringComparison.Ordinal) ? "-taken" : string.Empty) + ")")"><title>@phrases</title></path>
                @foreach (var mark in line.Marks)
                {
                    if (live is not null)
                    {
                        continue;
                    }

                    if (mark.IsCount)
                    {
                        <circle class="wb-count" cx="@Px(mark.X)" cy="@Px(mark.Y)" r="@Px(DiagramLayout.MarkRadius)"><title>@phrases</title></circle>
                        @SvgText(mark.X, mark.Y, "wb-count-t", Number(line.Routes.Count))
                    }
                    else
                    {
                        <circle class="wb-untried" cx="@Px(mark.X)" cy="@Px(mark.Y)" r="@Px(DiagramLayout.MarkRadius)"><title>@Plain("flow.read.untried")</title></circle>
                        @SvgText(mark.X, mark.Y, "wb-untried-t", "?")
                    }
                }
                @if (line.LabelAt is { } labelAt)
                {
                    @SvgText(labelAt.X, labelAt.Y, "wb-edge-t", line.ShortLabel!, line.LabelEndsAtPoint ? "end" : "start")
                }
                @if (line.NumberAt is { } numberAt)
                {
                    <circle class="wb-numbered" cx="@Px(numberAt.X)" cy="@Px(numberAt.Y)" r="@Px(DiagramLayout.MarkRadius)"><title>@line.FullLabel</title></circle>
                    @SvgText(numberAt.X, numberAt.Y, "wb-numbered-t", Number(line.Number))
                }
            </g>
        }
        @foreach (var node in d.Graph.Nodes)
{
    var box = boxes[node.Id];
    var family = node.Family;
    var step = node.Id;
    if (live is not null)
    {
        var order = live.Steps.ToList().FindIndex(item => string.Equals(item.Id, step, StringComparison.Ordinal)) + 1;
        var current = live.Steps.Any(item => item.IsCurrent && string.Equals(item.Id, step, StringComparison.Ordinal));
        <g @key="step" class="@("wb-node wb-node-live wb-node-" + FamilyKey(family) + (current ? " wb-node-now" : string.Empty) + (order > 0 ? " wb-node-seen" : string.Empty))" role="img" aria-label="@LiveNodeLabel(node, family, current, order)">
            <title>@node.Label</title>
            @NodeShape(family, box.X, box.Y, box.Width, box.Height)
            @NodeIcon(family, box.X, box.Y, box.Height)
            @for (var position = 0; position < box.Lines.Count; position++)
            {
                @SvgText(box.X + (box.Width / 2) + TextShift(family), box.Y + (box.Height / 2) + LineOffset(box.Lines.Count, position), "wb-node-t", box.Lines[position])
            }
            @if (node.IsStart)
            {
                <circle class="wb-node-start" cx="@Px(box.X + 12)" cy="@Px(box.Y + 12)" r="5"></circle>
            }
            @if (order > 0)
            {
                <circle class="wb-seen-badge" cx="@Px(box.X + 12)" cy="@Px(box.Y + box.Height - 12)" r="9"></circle>
                @SvgText(box.X + 12, box.Y + box.Height - 12, "wb-seen-badge-t", Number(order))
            }
            @if (current)
            {
                <circle class="wb-node-here" cx="@Px(box.X + box.Width - DiagramLayout.HereInset)" cy="@Px(box.Y + DiagramLayout.HereInset)" r="@Px(DiagramLayout.HereRadius)"></circle>
                @SvgText(box.X + box.Width - DiagramLayout.HereInset, box.Y + DiagramLayout.HereInset, "wb-node-here-t", "▶")
            }
        </g>
        continue;
    }

    var open = string.Equals(Session.SelectedStepId, step, StringComparison.Ordinal);
    var now = here == step;
    <g @key="step" class="@("wb-node wb-node-" + FamilyKey(family) + (now ? " wb-node-now" : string.Empty))" role="button" tabindex="0" aria-pressed="@(open ? "true" : "false")" aria-label="@NodeLabel(node, family, now)" @onclick="() => ToggleCard(step)" @onkeydown="args => OnNodeKeyDown(args, step)" @ref="refs[NodeRef(step)]">
        @{ Seen(NodeRef(step)); }
        <title>@node.Label</title>
        @NodeShape(family, box.X, box.Y, box.Width, box.Height)
        @NodeIcon(family, box.X, box.Y, box.Height)
        @for (var position = 0; position < box.Lines.Count; position++)
        {
            @SvgText(box.X + (box.Width / 2) + TextShift(family), box.Y + (box.Height / 2) + LineOffset(box.Lines.Count, position), "wb-node-t", box.Lines[position])
        }
        @if (node.IsStart)
        {
            <circle class="wb-node-start" cx="@Px(box.X + 12)" cy="@Px(box.Y + 12)" r="5"></circle>
        }
        @if (now)
        {
            <circle class="wb-node-here" cx="@Px(box.X + box.Width - DiagramLayout.HereInset)" cy="@Px(box.Y + DiagramLayout.HereInset)" r="@Px(DiagramLayout.HereRadius)"></circle>
            @SvgText(box.X + box.Width - DiagramLayout.HereInset, box.Y + DiagramLayout.HereInset, "wb-node-here-t", "▶")
        }
    </g>
}
</svg>
        </text>;
    }

    private RenderFragment DiagramPanel(FlowData d, FlowWork work)
    {
        var layout = d.LayoutFor(Plain("flow.read.noStage"));
        var here = TryStepId(work);
        var selected = Session.SelectedStepId is { } id ? d.View.Steps.FirstOrDefault(step => step.Id == id) : null;
        var untriedCount = d.Coverage.NeverTaken.Count;
        var hasLoose = layout.Bands.Any(band => band.IsLoose);

        return @<text>
            <div class="wb-diagram-top">
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="ReadAsList">@Rich("flow.diagram.readAsList")</button>
                <span class="wb-sub wb-sub-flush">@Rich("flow.diagram.hint")</span>
                @if (here is not null)
                {
                    <span class="@PillClass("sim")">@Rich("pill.simulation")</span>
                    <span class="wb-sub wb-sub-flush">@Plain("flow.diagram.tryAt", ("step", d.Words.Step(here)))</span>
                }
            </div>
            <div class="wb-diagram-wrap">
            <div class="wb-diagram-layout">
                <div class="wb-diagram-scroll" role="region" aria-label="@Plain("flow.diagram.scroll")" tabindex="0">
                    @DiagramSvg(d, layout, here, null)
                </div>
                @if (selected is not null)
                {
                    <aside class="wb-diagram-card" aria-label="@Plain("flow.diagram.card")">
                        <div class="wb-card-head">
                            <h2 class="wb-h2 wb-h2-flush">@Rich("flow.diagram.cardTitle")</h2>
                            <span class="wb-sp"></span>
                            <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => ToggleCard(selected.Id)">@Rich("flow.diagram.close")</button>
                        </div>
                        @StepBody(d, work, selected, true)
                    </aside>
                }
            </div>
            </div>
            @if (layout.NumberedLines.Any())
            {
                <section class="wb-marks" aria-labelledby="@(idp + "-marks")">
                    <h2 class="wb-h2" id="@(idp + "-marks")">@Rich("flow.diagram.marks")</h2>
                    <ul class="wb-marks-list">
                        @foreach (var line in layout.NumberedLines)
                        {
                            <li><strong class="wb-numbered-n">@Number(line.Number)</strong>: @line.FullLabel</li>
                        }
                    </ul>
                </section>
            }
            <section class="wb-card wb-legend" aria-labelledby="@(idp + "-legend")">
                <h2 class="wb-h2" id="@(idp + "-legend")">@Rich("flow.diagram.legend")</h2>
                <ul class="wb-legend-list">
                    @foreach (var family in LegendFamilies)
                    {
                        <li>
                            <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true">@NodeShape(family, 2, 2, 48, 24)@NodeIcon(family, 2, 2, 24)</svg>
                            <span>@Rich("flow.legend." + FamilyKey(family))</span>
                        </li>
                    }
                    <li>
                        <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><rect class="wb-node-shape" x="2" y="2" width="48" height="24" rx="6"></rect><circle class="wb-node-start" cx="12" cy="9" r="4"></circle></svg>
                        <span>@Rich("flow.legend.start")</span>
                    </li>
                    <li>
                        <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><rect class="wb-node-shape wb-node-now-sample" x="2" y="2" width="48" height="24" rx="6"></rect><circle class="wb-node-here" cx="38" cy="9" r="6"></circle></svg>
                        <span>@Rich("flow.legend.here")</span>
                    </li>
                    <li>
                        <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><line class="wb-edge" x1="2" y1="14" x2="50" y2="14"></line></svg>
                        <span>@Rich("flow.legend.happy")</span>
                    </li>
                    <li>
                        <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><line class="wb-edge wb-edge-side" x1="2" y1="14" x2="50" y2="14"></line></svg>
                        <span>@Rich("flow.legend.side")</span>
                    </li>
                    <li>
                        <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><path class="wb-edge wb-edge-side wb-edge-return" d="M 2 6 L 44 6 L 44 22 L 2 22"></path></svg>
                        <span>@Rich("flow.legend.cycle")</span>
                    </li>
                    <li>
                        <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><circle class="wb-count" cx="26" cy="14" r="8"></circle>@SvgText(26, 14, "wb-count-t", "2")</svg>
                        <span>@Rich("flow.legend.count")</span>
                    </li>
                    <li>
                        <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><circle class="wb-untried" cx="26" cy="14" r="8"></circle>@SvgText(26, 14, "wb-untried-t", "?")</svg>
                        <span>@if (untriedCount == 0){@Rich("flow.legend.allTried")}else{@PluralText("flow.legend.untried", untriedCount)}</span>
                    </li>
                    @if (layout.NumberedLines.Any())
                    {
                        <li>
                            <svg class="wb-legend-svg" width="52" height="28" viewBox="0 0 52 28" aria-hidden="true"><circle class="wb-numbered" cx="26" cy="14" r="8"></circle>@SvgText(26, 14, "wb-numbered-t", "1")</svg>
                            <span>@Rich("flow.legend.numbered")</span>
                        </li>
                    }
                    @if (hasLoose)
                    {
                        <li class="wb-legend-note"><span>@Rich("flow.legend.noStage")</span></li>
                    }
                </ul>
            </section>
        </text>;
    }

    private string NodeLabel(FlowNode node, FlowFamily family, bool now)
    {
        var parts = new List<string> { node.Label, FamilyWord(family) };
        if (node.IsStart)
        {
            parts.Add(Plain("flow.family.start"));
        }

        if (now)
        {
            parts.Add(Plain("flow.diagram.here"));
        }

        return string.Join(Plain("flow.join.label"), parts);
    }

    // ----- Simulate ---------------------------------------------------------------------------------------------------

    private RenderFragment TryPanel(FlowData d, FlowWork work)
    {
        var frame = CurrentFrame(work);
        return @<text>
            @Band("flow.band.try")
            <div class="wb-sr" role="status" aria-live="polite">@work.Live</div>
            @if (frame is null)
            {
                @StartForm(d, work)
            }
            else
            {
                @RunningCase(d, work, frame)
            }
        </text>;
    }

    private string FieldId(string key) => idp + "-fld-" + Number(TargetNumber("fld:" + key));

    private static string? HintKey(FlowFormField field) => field.Kind switch
    {
        FlowFieldKind.Number => field.Type == "Integer" ? "flow.field.hint.whole" : "flow.field.hint.number",
        FlowFieldKind.DateTime => "flow.field.hint.dateTime",
        FlowFieldKind.Lines => "flow.field.hint.lines",
        _ => null,
    };

    /// <summary>The control a form field gets, by its kind: a number, a date, a date and time (UTC), a checkbox for yes or no, several lines or a line of text.</summary>
    private RenderFragment FieldInput(string id, string refKey, FlowFormField field, string value, bool invalid, bool disabled, string? described, Action<ChangeEventArgs> change)
    {
        var css = invalid ? "wb-in wb-in-err" : "wb-in";
        var ariaInvalid = invalid ? "true" : null;
        return field.Kind switch
        {
            FlowFieldKind.YesNo => @<input id="@id" type="checkbox" class="wb-check" checked="@(value == "true")" disabled="@disabled" aria-describedby="@described" aria-invalid="@ariaInvalid" @onchange="args => change(CheckedArgs(args))" @ref="refs[refKey]" />,
            FlowFieldKind.Lines => @<textarea id="@id" class="@css" rows="3" value="@value" disabled="@disabled" aria-describedby="@described" aria-invalid="@ariaInvalid" @onchange="change" @ref="refs[refKey]"></textarea>,
            FlowFieldKind.Number => @<input id="@id" type="number" step="@(field.Type == "Integer" ? "1" : "any")" inputmode="decimal" class="@css" value="@value" disabled="@disabled" aria-describedby="@described" aria-invalid="@ariaInvalid" @onchange="change" @ref="refs[refKey]" />,
            FlowFieldKind.Date => @<input id="@id" type="date" class="@css" value="@value" disabled="@disabled" aria-describedby="@described" aria-invalid="@ariaInvalid" @onchange="change" @ref="refs[refKey]" />,
            FlowFieldKind.DateTime => @<input id="@id" type="datetime-local" class="@css" value="@value" disabled="@disabled" aria-describedby="@described" aria-invalid="@ariaInvalid" @onchange="change" @ref="refs[refKey]" />,
            _ => @<input id="@id" type="text" autocomplete="off" class="@css" value="@value" disabled="@disabled" aria-describedby="@described" aria-invalid="@ariaInvalid" @onchange="change" @ref="refs[refKey]" />,
        };
    }

    /// <summary>One control of a form, by the kind of the field, with its label (the name of the variable as code), its hint and, when its text could not be read, its error.</summary>
    private RenderFragment FieldControl(string id, string refKey, RenderFragment label, FlowFormField field, string value, bool invalid, Action<ChangeEventArgs> change, bool disabled = false, bool addUtc = true)
    {
        var hintKey = HintKey(field);
        var describedBy = (invalid ? id + "-err " : string.Empty) + (hintKey is not null ? id + "-hint" : string.Empty);
        var described = describedBy.Length > 0 ? describedBy.Trim() : null;
        var isCheck = field.Kind == FlowFieldKind.YesNo;
        return @<div class="@(isCheck ? "wb-field wb-field-check" : "wb-field")">
            @{ Seen(refKey); }
            @if (isCheck)
            {
                @FieldInput(id, refKey, field, value, invalid, disabled, described, change)
                <label class="wb-label" for="@id">@label</label>
            }
            else
            {
                <label class="wb-label" for="@id">@label@if (field.Kind == FlowFieldKind.DateTime && addUtc){@(" ")@Plain("flow.field.utc")}</label>
                @FieldInput(id, refKey, field, value, invalid, disabled, described, change)
            }
            @if (hintKey is not null)
            {
                <div class="wb-hint" id="@(id + "-hint")">@Rich(hintKey)</div>
            }
            @if (invalid)
            {
                <div class="wb-errt" id="@(id + "-err")">@Rich("flow.field.invalid")</div>
            }
        </div>;
    }

    private RenderFragment StartForm(FlowData d, FlowWork work)
    {
        var fields = FlowForms.StartFields(d.Process);
        var likeId = idp + "-start-like";
        var atInvalid = work.StartInvalid.Contains(StartRef);
        return @<div class="wb-card">
            <h2 class="wb-h2">@Rich("flow.try.start.title")</h2>
            <p class="wb-sub">@Rich("flow.try.start.help")</p>
            @if (d.Outline.Scenarios.Count > 0)
            {
                <div class="wb-field wb-field-gap">
                    <label class="wb-label" for="@likeId">@Rich("flow.try.start.like")</label>
                    <select id="@likeId" class="wb-in" value="@work.StartLike" @onchange="args => StartLike(d, work, args)">
                        <option value="">@Plain("flow.try.start.likeNone")</option>
                        @foreach (var name in d.Outline.Scenarios)
                        {
                            <option value="@name">@Quoted(name)</option>
                        }
                    </select>
                </div>
            }
            @if (fields.Count == 0)
            {
                <div class="wb-sub">@Rich("flow.try.start.noInputs")</div>
            }
            @foreach (var field in fields)
            {
                var name = field.Name;
                var value = work.StartValues.TryGetValue(name, out var typed) ? typed : string.Empty;
                <div class="wb-field-gap">
                    @FieldControl(FieldId("start:" + name), StartFieldRef(name), VarName(name), field, value, work.StartInvalid.Contains(name), args => SetStartValue(work, name, args))
                </div>
            }
            <div class="wb-field wb-field-gap">
                @FieldControl(FieldId("start:at"), StartFieldRef(StartRef), Rich("flow.try.start.at"), new FlowFormField("start", "Instant", FlowFieldKind.DateTime), StartAtText(work), atInvalid, args => SetStartAt(work, args), addUtc: false)
            </div>
            @if (work.StartRefusal is { } refusal)
            {
                <div class="wb-errt" role="alert">@Sentence(Reason(refusal.Length == 0 ? null : refusal))</div>
            }
            <div class="wb-actions">
                <button type="button" class="wb-btn wb-btn-primary" @onclick="() => StartTryOut(d, work)" @ref="refs[StartRef]">@Rich("flow.try.start.go")</button>
                @{ Seen(StartRef); }
            </div>
        </div>;
    }

    private static string VarText(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            return document.RootElement.ValueKind == System.Text.Json.JsonValueKind.String ? document.RootElement.GetString() ?? string.Empty : json;
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }

    /// <summary>The controls of a replay: which command of the scenario is next, and the two ways to go on. They are drawn while the scenario has commands left.</summary>
    private RenderFragment ReplayBar(FlowData d, FlowWork work, FlowReplay replay) => @<div class="wb-card wb-card-gap wb-replay" role="group" aria-label="@Plain("flow.try.replay.label")">
        <div class="wb-hint">@Rich("flow.try.replaying", ("name", Quoted(replay.Name)))</div>
        <div class="wb-sub" role="status">@Rich("flow.try.replay.progress", ("n", Number(replay.Played)), ("t", Number(replay.Total)))</div>
        <div class="wb-actions">
            <button type="button" class="wb-btn wb-btn-primary wb-btn-sm" @onclick="() => ReplayNext(d, work)" @ref="refs[ReplayNextRef]">@Rich("flow.try.replay.next")</button>
            @{ Seen(ReplayNextRef); }
            <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => ReplayAll(d, work)">@Rich("flow.try.replay.all")</button>
        </div>
    </div>;

    private RenderFragment RunningCase(FlowData d, FlowWork work, TryFrame frame)
    {
        var simulation = frame.Simulation;
        var (words, view) = InfoOf(d, frame);
        var step = simulation.CurrentStep is { } id ? view.Steps.FirstOrDefault(item => item.Id == id) : null;
        var ended = simulation.Status is ProcessStatus.Completed or ProcessStatus.Cancelled;
        var isChild = work.Frames.Count > 1;
        var isLast = work.Frames.Count > 0 && ReferenceEquals(frame, work.Frames[^1]);
        var locked = work.IsReplaying;
        var outstanding = simulation.Outstanding;
        var variables = simulation.Variables.OrderBy(pair => pair.Key, StringComparer.Ordinal).ToList();
        return @<text>
            @if (work.Replay is { } replay)
            {
                if (!replay.IsFinished)
                {
                    @ReplayBar(d, work, replay)
                }
                else if (replay.Failure is { } replayFailure)
                {
                    @FailureBlock(replayFailure)
                }
            }
            @if (isChild)
            {
                <div class="wb-card wb-card-gap">
                    <div class="wb-card-head">
                        <strong>@Rich("flow.try.child.inside", ("title", words.Title()))</strong>
                        <span class="wb-sp"></span>
                        <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => BackToParent(d, work)">@Rich("flow.try.child.back")</button>
                        @if (simulation.Status == ProcessStatus.Completed)
                        {
                            <button type="button" class="wb-btn wb-btn-primary wb-btn-sm" @onclick="() => BringResultBack(d, work)">@Rich("flow.try.child.bring")</button>
                        }
                    </div>
                </div>
            }
            <div class="wb-card wb-card-gap">
                <h2 class="wb-h2" tabindex="-1" @ref="refs[WhereRef]">@Rich("flow.try.where.title")</h2>
                @{ Seen(WhereRef); }
                <dl class="wb-kv">
                    <dt>@Rich("flow.try.where.status")</dt>
                    <dd><span class="@PillClass(ended ? "ok" : "sim")">@StatusWord(simulation.Status)</span></dd>
                    <dt>@Rich("flow.try.where.time")</dt>
                    <dd>@TimeText(simulation.Now)</dd>
                    @if (ended && simulation.State.Result is { } result)
                    {
                        <dt>@Rich("flow.try.where.result")</dt>
                        <dd>@words.Result(result)</dd>
                    }
                    @if (step is not null)
                    {
                        <dt>@Rich("flow.try.where.step")</dt>
                        <dd>@step.Label@if (step.StageLabel is not null){@(" ")<span class="wb-sub">@Plain("flow.try.where.inStage", ("stage", step.StageLabel))</span>}</dd>
                        <dt>@Rich("flow.try.where.does")</dt>
                        <dd>@Sentence(step.Sentence)</dd>
                    }
                </dl>
                <h3 class="wb-h3">@Rich("flow.try.where.variables")</h3>
                @if (variables.Count == 0)
                {
                    <div class="wb-sub">@Rich("flow.try.where.noVariables")</div>
                }
                else
                {
                    <dl class="wb-kv">
                        @foreach (var pair in variables)
                        {
                            <dt>@VarName(pair.Key)</dt>
                            <dd>@VarText(pair.Value)</dd>
                        }
                    </dl>
                }
                @if (isLast && !isChild)
                {
                    <div class="wb-actions">
                        <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="ReadAsList">@Rich("flow.try.where.seeRead")</button>
                        <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => SelectTab(FlowWorkbenchTab.Diagram)">@Rich("flow.try.where.seeDiagram")</button>
                    </div>
                }
            </div>
            @if (simulation.Status == ProcessStatus.Suspended)
            {
                <div class="wb-card wb-card-gap">
                    <p class="wb-sub">@Rich("flow.try.suspended")</p>
                    <div class="wb-actions"><button type="button" class="wb-btn wb-btn-secondary" disabled="@locked" @onclick="() => ResumeCase(d, work, frame)">@Rich("flow.try.resume")</button></div>
                </div>
            }
            @if (!ended)
            {
                <h2 class="wb-h2">@Rich("flow.try.waits.title")</h2>
                @if (outstanding.Count == 0)
                {
                    <div class="wb-sub">@Rich("flow.try.waits.none")</div>
                }
                @foreach (var item in outstanding)
                {
                    @WaitingCard(d, work, frame, words, view, item, locked)
                }
                @TimeControls(d, work, frame, locked)
            }
            else
            {
                <div class="wb-card wb-card-gap" role="status">@Rich(simulation.Status == ProcessStatus.Completed ? "flow.try.ended" : "flow.try.cancelled")</div>
            }
            @Timeline(words, frame)
            @if (isLast)
            {
                @KeepControls(d, work)
            }
        </text>;
    }

    private RenderFragment RefusalFor(TryFrame frame, string card) =>
        frame.Refusal is { } refusal && refusal.Card == card
            ? @<div class="wb-errt" role="alert"><span aria-hidden="true">!</span> @Sentence(Reason(refusal.Code.Length == 0 ? null : refusal.Code))</div>
            : @<text></text>;

    /// <summary>What a test says when it fails: a plain sentence, and the words of the test player as technical detail, written as code.</summary>
    private RenderFragment FailureBlock(string reason) => @<div class="wb-errt" role="alert">
        <div>@Rich("flow.tests.failure")</div>
        @if (reason.Length > 0)
        {
            <div class="wb-small"><span class="wb-sub">@Plain("flow.tests.technical")</span>@(" ")<code class="wb-code">@reason</code></div>
        }
    </div>;

    private RenderFragment WaitingCard(FlowData d, FlowWork work, TryFrame frame, FlowWords words, FlowView view, FlowOutstanding item, bool locked) => item switch
    {
        OutstandingEffect effect => EffectCard(d, work, frame, words, view, effect, locked),
        OutstandingTask task => TaskCard(d, work, frame, words, task, locked),
        OutstandingWait wait => EventCard(d, work, frame, words, wait, locked),
        OutstandingTimer timer => MomentCard(d, work, frame, words, timer.Id, timer.Step, timer.Due, "flow.try.timer", locked),
        OutstandingWindow window => MomentCard(d, work, frame, words, window.Id, window.Step, window.OpensAt, "flow.try.window", locked),
        OutstandingChild child => ChildCard(d, work, frame, words, child, locked),
        _ => @<text></text>,
    };

    private RenderFragment EffectCard(FlowData d, FlowWork work, TryFrame frame, FlowWords words, FlowView view, OutstandingEffect effect, bool locked)
    {
        var step = view.Steps.FirstOrDefault(item => item.Id == effect.Step);
        var fields = FlowSchemaFields.From(step?.Ai?.OutputSchemaJson);
        var answers = FlowScenarioAnswers.For(frame.Simulation, effect.Step);
        var picked = PickedAnswer(frame, effect.Id, answers);
        var source = frame.Simulation.AnswerSource;
        var busy = asking is not null || locked;
        var thisBusy = asking is not null && askingEffect == effect.Id;
        var answerId = FieldId("answer:" + effect.Id);
        var headingId = FieldId("effect:" + effect.Id);
        var pickId = FieldId("pick:" + effect.Id);
        return @<section class="wb-card wb-card-gap wb-wait" aria-labelledby="@headingId">
            <h3 class="wb-step-t" id="@headingId">@Rich("flow.try.effect.title", ("step", words.Step(effect.Step)))</h3>
            <div class="wb-sub">@Weave("flow.try.effect.port", [("n", Number(effect.Attempt))], ("port", effect.Port))</div>
            @if (fields.Count > 0)
            {
                <div class="wb-hint">@Rich("flow.try.effect.shape")</div>
                <ul class="wb-flow-list">
                    @foreach (var field in fields)
                    {
                        <li>@Code(field.Name)@(" ")@Plain("flow.ai.field", ("type", TypeWord(field.Type)), ("required", field.IsRequired ? Plain("flow.ai.required") : Plain("flow.ai.optional")))</li>
                    }
                </ul>
            }
            @if (picked is not null)
            {
                <div class="wb-field wb-field-gap">
                    <label class="wb-label" for="@pickId">@Rich("flow.try.effect.pick")</label>
                    <div class="wb-pick">
                        <select id="@pickId" class="wb-in" value="@picked.Scenario" disabled="@busy" @onchange="args => SetInput(frame, PickKey(effect.Id), args)">
                            @foreach (var option in answers)
                            {
                                <option value="@option.Scenario">@Quoted(option.Scenario)@(option.Answer.IsFailure ? " " + Plain("flow.try.effect.failsMark") : string.Empty)</option>
                            }
                        </select>
                        <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@busy" @onclick="() => AnswerFromTest(d, work, frame, effect, picked.Answer)">@Rich("flow.try.effect.use")</button>
                    </div>
                </div>
            }
            <div class="wb-actions">
                @if (source is not null)
                {
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@busy" @onclick="() => AskAsync(d, work, frame, effect)">@Rich("flow.try.effect.ask", ("source", Quoted(source.Name)))</button>
                }
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@busy" @onclick="() => FailEffect(d, work, frame, effect, false)">@Rich("flow.try.effect.failTemp")</button>
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@busy" @onclick="() => FailEffect(d, work, frame, effect, true)">@Rich("flow.try.effect.failPerm")</button>
            </div>
            @if (thisBusy)
            {
                <div class="wb-busy" role="status"><span aria-hidden="true">...</span> @Rich("flow.try.effect.asking", ("source", Quoted(source?.Name ?? string.Empty))) <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="CancelAsk">@Rich("flow.try.effect.cancelAsk")</button></div>
            }
            <details class="wb-fold">
                <summary>@Rich("flow.try.effect.write")</summary>
                <label class="wb-label" for="@answerId">@Rich("flow.try.effect.writeLabel")</label>
                <textarea id="@answerId" class="wb-in" rows="3" value="@InputOf(frame, AnswerKey(effect.Id))" disabled="@locked" @onchange="args => SetInput(frame, AnswerKey(effect.Id), args)"></textarea>
                <div class="wb-hint">@Rich("flow.try.effect.writeHelp")</div>
                <div class="wb-actions"><button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@busy" @onclick="() => AnswerByHand(d, work, frame, effect)">@Rich("flow.try.effect.send")</button></div>
            </details>
            @RefusalFor(frame, effect.Id)
        </section>;
    }

    private RenderFragment TaskCard(FlowData d, FlowWork work, TryFrame frame, FlowWords words, OutstandingTask task, bool locked)
    {
        var shown = ShownValues(task.ShowJson);
        var headingId = FieldId("task:" + task.Id);
        return @<section class="wb-card wb-card-gap wb-wait" aria-labelledby="@headingId">
            <h3 class="wb-step-t" id="@headingId">@Rich("flow.try.task.title", ("step", words.Step(task.Step)))</h3>
            <div class="wb-sub">@Rich("flow.try.task.queue", ("queue", words.Queue(task.Queue)))</div>
            @if (shown.Count > 0)
            {
                <dl class="wb-kv">
                    @foreach (var (name, value) in shown)
                    {
                        <dt>@VarName(name)</dt>
                        <dd>@value</dd>
                    }
                </dl>
            }
            <div class="wb-hint">@Rich("flow.try.task.choose")</div>
            <div class="wb-actions">
                @foreach (var outcome in task.Outcomes)
                {
                    var chosen = outcome;
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@locked" @onclick="() => CompleteTask(d, work, frame, task, chosen)">@words.Outcome(outcome)</button>
                }
            </div>
            @RefusalFor(frame, task.Id)
        </section>;
    }

    private RenderFragment EventCard(FlowData d, FlowWork work, TryFrame frame, FlowWords words, OutstandingWait wait, bool locked)
    {
        var fields = FlowForms.PayloadFields(frame.Simulation.Process, wait.Step);
        var invalid = frame.Invalid.TryGetValue(wait.Id, out var names) ? names : [];
        var headingId = FieldId("wait:" + wait.Id);
        return @<section class="wb-card wb-card-gap wb-wait" aria-labelledby="@headingId">
            <h3 class="wb-step-t" id="@headingId">@Rich("flow.try.event.title", ("step", words.Step(wait.Step)))</h3>
            <div class="wb-sub">@Rich("flow.try.event.waiting", ("event", words.Event(wait.Event)))@if (wait.Correlation is not null){@(" ")@Weave("flow.try.event.correlation", [], ("value", wait.Correlation))}</div>
            @if (fields.Count > 0)
            {
                <div class="wb-hint">@Rich("flow.try.event.payload")</div>
            }
            @foreach (var field in fields)
            {
                var name = field.Name;
                var key = FieldKey(wait.Id, name);
                <div class="wb-field-gap">
                    @FieldControl(FieldId(key), FieldRefOf(wait.Id, name), VarName(name), field, InputOf(frame, key), invalid.Contains(name), args => SetInput(frame, key, args), locked)
                </div>
            }
            <div class="wb-actions"><button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@locked" @onclick="() => SendEvent(d, work, frame, wait)">@Rich("flow.try.event.send")</button></div>
            @RefusalFor(frame, wait.Id)
        </section>;
    }

    private RenderFragment MomentCard(FlowData d, FlowWork work, TryFrame frame, FlowWords words, string id, string stepId, DateTimeOffset due, string key, bool locked)
    {
        var headingId = FieldId("moment:" + id);
        return @<section class="wb-card wb-card-gap wb-wait" aria-labelledby="@headingId">
            <h3 class="wb-step-t" id="@headingId">@Rich(key + ".title", ("step", words.Step(stepId)))</h3>
            <div class="wb-sub">@Rich(key + ".until", ("time", TimeText(due)))</div>
            <div class="wb-actions"><button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@locked" @onclick="() => GoToMoment(d, work, frame, id, due)">@Rich("flow.try.goTo")</button></div>
            @RefusalFor(frame, id)
        </section>;
    }

    /// <summary>The results the child flow can give, as the child's own document words them.</summary>
    private List<(string Id, string Word)> ChildOptions(OutstandingChild child)
    {
        var target = FlowWithId(child.ProcessId);
        if (target is null || Data(target) is not { } childData)
        {
            return [];
        }

        return [.. FlowLibrary.ResultsOf(childData.Process).Select(item => (item, childData.Words.Result(item)))];
    }

    private RenderFragment ChildCard(FlowData d, FlowWork work, TryFrame frame, FlowWords words, OutstandingChild child, bool locked)
    {
        var options = ChildOptions(child);
        var canOpen = FlowWithId(child.ProcessId) is not null;
        var headingId = FieldId("child:" + child.Id);
        var resultKey = FieldKey(child.Id, "result");
        var resultId = FieldId(resultKey);
        var current = InputOf(frame, resultKey);
        return @<section class="wb-card wb-card-gap wb-wait" aria-labelledby="@headingId">
            <h3 class="wb-step-t" id="@headingId">@Rich("flow.try.child.title", ("step", words.Step(child.Step)))</h3>
            <div class="wb-sub">@Rich("flow.try.child.waiting", ("title", TitleOfId(child.ProcessId)))</div>
            <div class="wb-field wb-field-gap">
                <label class="wb-label" for="@resultId">@Rich("flow.try.child.resultLabel")</label>
                @if (options.Count > 0)
                {
                    <select id="@resultId" class="wb-in" value="@(current.Length > 0 ? current : options[0].Id)" disabled="@locked" @onchange="args => SetInput(frame, resultKey, args)">
                        @foreach (var option in options)
                        {
                            <option value="@option.Id">@option.Word</option>
                        }
                    </select>
                }
                else
                {
                    <input id="@resultId" type="text" autocomplete="off" class="wb-in" value="@current" disabled="@locked" @onchange="args => SetInput(frame, resultKey, args)" />
                }
            </div>
            <div class="wb-actions">
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@locked" @onclick="() => FinishChild(d, work, frame, child)">@Rich("flow.try.child.finish")</button>
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@locked" @onclick="() => FailChild(d, work, frame, child)">@Rich("flow.try.child.fail")</button>
                @if (canOpen)
                {
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@locked" @onclick="() => OpenChild(d, work, frame, child)">@Rich("flow.try.child.open")</button>
                }
            </div>
            @RefusalFor(frame, child.Id)
        </section>;
    }

    private RenderFragment TimeControls(FlowData d, FlowWork work, TryFrame frame, bool locked)
    {
        var next = frame.Simulation.NextDue;
        return @<section class="wb-card wb-card-gap" aria-labelledby="@FieldId("time")">
            <h3 class="wb-step-t" id="@FieldId("time")">@Rich("flow.try.time.title")</h3>
            <div class="wb-actions">
                @foreach (var passage in Passages)
                {
                    var span = passage.Span;
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@locked" @onclick="() => LetPass(d, work, frame, span)">@Rich(passage.Key)</button>
                }
                @if (next is { } moment)
                {
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@locked" @onclick="() => GoToMoment(d, work, frame, TimeCard, moment)">@Rich("flow.try.pass.next", ("time", TimeText(moment)))</button>
                }
            </div>
            @RefusalFor(frame, TimeCard)
        </section>;
    }

    private RenderFragment Timeline(FlowWords words, TryFrame frame)
    {
        var log = frame.Simulation.Log;
        return @<section class="wb-card wb-card-gap" aria-labelledby="@FieldId("log")">
            <h3 class="wb-step-t" id="@FieldId("log")">@Rich("flow.try.log.title")</h3>
            @if (log.Count == 0)
            {
                <div class="wb-sub">@Rich("flow.try.log.empty")</div>
            }
            else
            {
                <ol class="wb-timeline">
                    @foreach (var entry in log)
                    {
                        var refused = entry.Disposition != AdvanceDisposition.Applied;
                        <li>
                            <span class="wb-sub">@TimeText(entry.At)</span>@(" ")<span>@Plain("flow.log.who", ("who", WhoOf(entry)))</span>@(" ")<span>@EntryText(entry, words)</span>
                            @if (refused)
                            {
                                @(" ")<span class="@PillClass("bad")">@Rich("flow.try.log.refused")</span>@(" ")<span>@Sentence(Reason(entry.Code))</span>
                            }
                            else if (Entered(entry, words) is { Length: > 0 } entered)
                            {
                                @(" ")<span class="wb-sub">@entered</span>
                            }
                        </li>
                    }
                </ol>
            }
        </section>;
    }

    private RenderFragment KeepControls(FlowData d, FlowWork work)
    {
        var nameId = FieldId("save");
        var invalid = work.SaveError is not null;
        return @<section class="wb-card wb-card-gap" aria-labelledby="@FieldId("keep")">
            <h3 class="wb-step-t" id="@FieldId("keep")">@Rich("flow.try.keep.title")</h3>
            <div class="wb-field">
                <label class="wb-label" for="@nameId">@Rich("flow.try.keep.nameLabel")</label>
                <input id="@nameId" type="text" autocomplete="off" class="@(invalid ? "wb-in wb-in-err" : "wb-in")" value="@work.SaveName" aria-describedby="@(invalid ? nameId + "-err" : nameId + "-hint")" aria-invalid="@(invalid ? "true" : null)" @onchange="args => SetSaveName(work, args)" @ref="refs[SaveNameRef]" />
                @{ Seen(SaveNameRef); }
                <div class="wb-hint" id="@(nameId + "-hint")">@Rich("flow.try.keep.help")</div>
                @if (work.SaveError is { } error)
                {
                    <div class="wb-errt" id="@(nameId + "-err")" role="alert">@Rich(error)</div>
                }
            </div>
            <div class="wb-actions">
                <button type="button" class="wb-btn wb-btn-secondary" @onclick="() => SaveAsProposed(d, work)">@Rich("flow.try.keep.save")</button>
                <button type="button" class="wb-btn wb-btn-secondary" @onclick="() => AskReset(work)">@Rich("flow.try.reset.ask")</button>
            </div>
            @if (work.Proposed.Count > 0)
            {
                <div class="wb-hint">@PluralText("flow.try.keep.saved", work.Proposed.Count)</div>
            }
            @if (work.ConfirmReset)
            {
                <div class="wb-card wb-confirm" role="alert">
                    <p>@Rich("flow.try.reset.question")</p>
                    <div class="wb-actions">
                        <button type="button" class="wb-btn wb-btn-secondary" @onclick="() => KeepTryOut(work)" @ref="refs[KeepResetRef]">@Rich("flow.try.reset.keep")</button>
                        @{ Seen(KeepResetRef); }
                        <button type="button" class="wb-btn wb-btn-primary" @onclick="() => StartOver(work)">@Rich("flow.try.reset.discard")</button>
                    </div>
                </div>
            }
        </section>;
    }

    // ----- Tests and coverage -----------------------------------------------------------------------------------------

    /// <summary>
    /// One test of the flow: the document's own or a proposed one. Both get the same lines: the result, the steps it goes through, a
    /// small review control and a way to replay it in the Simulate tab.
    /// </summary>
    private RenderFragment ScenarioRow(FlowData d, FlowWork work, ScenarioLine line, string? proposedJson = null, bool valid = true)
    {
        var target = "scenario:" + line.Name;
        var headingId = FieldId("scenario:" + line.Name);
        var name = line.Name;
        var (tone, mark, wordKey) = ScenarioLook(valid, line.Passed);
        return @<li class="wb-card wb-card-gap wb-scenario">
            <div class="wb-card-head">
                <h3 class="wb-step-t" id="@headingId">@line.Name</h3>
                @if (proposedJson is not null)
                {
                    <span class="@PillClass("neutral")">@Rich("flow.tests.proposed")</span>
                }
                <span class="@PillClass(tone)"><span aria-hidden="true">@mark</span>@(" ")@Rich(wordKey)</span>
                <span class="wb-sp"></span>
                @ReviewControl(work, target, Plain("flow.review.groupScenario", ("name", Quoted(line.Name))))
            </div>
            @if (!valid)
            {
                <div class="wb-errt">@Rich("flow.tests.invalidBody")</div>
            }
            else if (!line.Passed)
            {
                @FailureBlock(line.Failure ?? string.Empty)
            }
            @if (line.Trace.Count > 0)
            {
                <div class="wb-hint">@Rich("flow.tests.goesThrough")</div>
                <ol class="wb-trace" aria-labelledby="@headingId">
                    @foreach (var step in line.Trace)
                    {
                        <li>@step</li>
                    }
                </ol>
            }
            @NoteEditor(work, target)
            <div class="wb-actions">
                @if (valid)
                {
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => Replay(d, work, name, proposedJson)">@Rich("flow.tests.replay", ("name", Quoted(name)))</button>
                }
                @if (proposedJson is not null)
                {
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => RemoveProposed(work, name)">@Rich("flow.tests.remove", ("name", Quoted(name)))</button>
                }
            </div>
        </li>;
    }

    private RenderFragment TestsPanel(FlowData d, FlowWork work)
    {
        var coverage = d.Coverage;
        return @<text>
            @Band("flow.band.tests")
            <h2 class="wb-h2">@Rich("flow.tests.title")</h2>
            @if (d.Scenarios.Count == 0)
            {
                <div class="wb-sub">@Rich("flow.tests.none")</div>
            }
            else
            {
                <ul class="wb-flow-list wb-plain-list">
                    @foreach (var line in d.Scenarios)
                    {
                        @ScenarioRow(d, work, line)
                    }
                </ul>
            }
            @if (work.Proposed.Count > 0)
            {
                <h2 class="wb-h2">@Rich("flow.tests.proposedTitle")</h2>
                <p class="wb-sub">@Rich("flow.tests.proposedHelp")</p>
                <ul class="wb-flow-list wb-plain-list">
                    @foreach (var proposed in work.Proposed)
                    {
                        var result = ProposedResult(d, work, proposed);
                        @ScenarioRow(d, work, new ScenarioLine(proposed.Name, result?.Passed ?? false, result?.Failure, result?.Trace ?? []), proposed.Json, result is not null)
                    }
                </ul>
            }
            <section class="wb-card wb-card-gap" aria-labelledby="@FieldId("coverage")">
                <h2 class="wb-h2" id="@FieldId("coverage")">@Rich("flow.coverage.title")</h2>
                <p>@Plain("flow.coverage.routes", ("n", Number(coverage.CoveredRoutes)), ("t", Number(coverage.TotalRoutes)))</p>
                <p>@Plain("flow.coverage.steps", ("n", Number(coverage.EnteredSteps)), ("t", Number(coverage.TotalSteps)))</p>
                @if (coverage.NeverTaken.Count > 0)
                {
                    <h3 class="wb-h3">@Rich("flow.coverage.untriedTitle")</h3>
                    <ul class="wb-flow-list">
                        @foreach (var route in coverage.NeverTaken)
                        {
                            var routeStep = d.View.Steps.First(item => item.Id == route.Step);
                            var phrase = routeStep.Routes.FirstOrDefault(item => item.Label == route.Label)?.Phrase ?? route.Label;
                            <li>@Sentence(Plain("flow.coverage.untriedRoute", ("step", d.Words.Step(route.Step)), ("route", phrase)))</li>
                        }
                    </ul>
                }
                @if (coverage.StepsNeverEntered.Count > 0)
                {
                    <h3 class="wb-h3">@Rich("flow.coverage.unenteredTitle")</h3>
                    <ul class="wb-flow-list">
                        @foreach (var step in coverage.StepsNeverEntered)
                        {
                            <li>@d.Words.Step(step)</li>
                        }
                    </ul>
                }
                @if (coverage.Problems.Count > 0)
                {
                    <h3 class="wb-h3">@Rich("flow.coverage.problemsTitle")</h3>
                    <ul class="wb-flow-list">
                        @foreach (var problem in coverage.Problems)
                        {
                            <li>@Rich("flow.coverage.problem", ("name", Quoted(problem.Path)))</li>
                        }
                    </ul>
                }
                @if (coverage.NeverTaken.Count == 0 && coverage.StepsNeverEntered.Count == 0 && coverage.Problems.Count == 0)
                {
                    <div class="wb-saved" role="status">@Rich("flow.coverage.complete")</div>
                }
            </section>
        </text>;
    }

    // ----- Review -----------------------------------------------------------------------------------------------------

    private RenderFragment ReviewPanel(FlowData d, FlowWork work)
    {
        var targets = TargetsOf(d, work);
        var shown = targets.Where(target => work.Review(target).State != ReviewState.Unreviewed || work.Review(target).Note.Length > 0 || IsProposed(work, target)).ToList();
        var markedCount = targets.Count(target => work.Review(target).State != ReviewState.Unreviewed);
        var unreviewed = targets.Count - markedCount;
        var exportable = ExportableFlowCount();
        var missing = FlowsMissingNotes();
        var missingNotes = missing.Sum(item => item.Count);
        var orphans = OrphanCount();
        var reviewerId = idp + "-reviewer";
        return @<text>
            @PrivacyNotice()
            <div class="wb-grid2 wb-grid-review">
                <div>
                    <h2 class="wb-h2">@Rich("flow.review.title")</h2>
                    <p class="wb-sub" role="status">@Rich("flow.review.progress", ("n", Number(markedCount)), ("t", Number(targets.Count)))</p>
                    @if (shown.Count == 0)
                    {
                        <div class="wb-sub">@Rich("flow.review.empty")</div>
                    }
                    else
                    {
                        <table class="wb-table">
                            <thead>
                                <tr>
                                    <th scope="col">@Rich("flow.review.th.about")</th>
                                    <th scope="col">@Rich("flow.review.th.state")</th>
                                    <th scope="col">@Rich("flow.review.th.note")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var target in shown)
                                {
                                    var entry = work.Review(target);
                                    var about = TargetName(d, target);
                                    <tr>
                                        <td>@about</td>
                                        <td>
                                            @if (entry.State == ReviewState.Unreviewed && IsProposed(work, target))
                                            {
                                                <span class="@PillClass("neutral")">@Rich("flow.review.proposed")</span>
                                            }
                                            else
                                            {
                                                <span class="@PillClass(StateTone(entry.State))">@StateWord(entry.State)</span>
                                            }
                                        </td>
                                        <td>
                                            @if (entry.NeedsNote)
                                            {
                                                @MissingNote(work, target)
                                            }
                                            @NoteEditor(work, target, about)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    @if (unreviewed > 0)
                    {
                        <div class="wb-cell-gap">
                            <span class="wb-sub">@PluralText("flow.review.unreviewedCount", unreviewed)</span>
                            <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="ReadAsList">@Rich("flow.review.goRead")</button>
                        </div>
                    }
                </div>
                <div class="wb-card">
                    <h2 class="wb-h2">@Rich("flow.review.cardTitle")</h2>
                    @if (exportable > 0)
                    {
                        <div class="wb-hint">@PluralText("flow.review.scope", exportable)</div>
                    }
                    @if (OnExport is not null)
                    {
                        <div class="wb-field wb-field-gap">
                            <label class="wb-label" for="@reviewerId">@Rich("flow.review.name")</label>
                            <input id="@reviewerId" type="text" autocomplete="off" class="@(nameError ? "wb-in wb-in-err" : "wb-in")" value="@Session.Reviewer" aria-describedby="@(nameError ? reviewerId + "-err" : null)" aria-invalid="@(nameError ? "true" : null)" @onchange="SetReviewer" @ref="refs[ReviewerRef]" />
                            @{ Seen(ReviewerRef); }
                            @if (nameError)
                            {
                                <div class="wb-errt" id="@(reviewerId + "-err")">@Rich("flow.review.nameRequired")</div>
                            }
                        </div>
                        <div class="wb-actions">
                            <button type="button" class="wb-btn wb-btn-primary" disabled="@(exportable == 0)" @onclick="ExportAsync">@Rich("flow.review.export")</button>
                        </div>
                        @if (notesHeld && missingNotes > 0)
                        {
                            <div class="wb-errt" role="alert">@PluralText("flow.review.notesNeeded", missingNotes, ("flows", string.Join(Plain("flow.join"), missing.Select(item => item.Label))))</div>
                        }
                        @if (exportable == 0)
                        {
                            <div class="wb-hint">@Rich("flow.review.nothingToExport")</div>
                        }
                        <div class="wb-hint">@Rich("flow.review.exportHelp")</div>
                        @if (exportDone && ListedUnexportedCount() == 0)
                        {
                            <div class="wb-saved" role="status">@(exportPlace is null ? Rich("flow.review.savedNoPlace") : Rich("flow.review.saved", ("place", exportPlace)))</div>
                        }
                        @if (orphans > 0)
                        {
                            <div class="wb-hint" role="status">@PluralText("flow.review.orphans", orphans)</div>
                        }
                    }
                </div>
            </div>
        </text>;
    }
}
