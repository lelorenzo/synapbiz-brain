                <span class="wb-num">@SimulationPresenter.Number(fallback)</span>
                <div>
                    <div class="wb-sent">@fallback.Sentence</div>
                    @if (c.Rule.RowTexts.TryGetValue(fallback.RowId, out var fallbackText))
                    {
                        <div class="wb-sub">@Rich("read.rowTextPrefix") «@fallbackText»</div>
                    }
