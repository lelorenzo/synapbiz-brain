@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Nuvora.Decisions.Contracts.Tables
@using Synapbiz.Brain.Spec
@using Synapbiz.Brain.Workbench
@using System.Globalization
@using Nuvora.Decisions.Contracts.Evaluation
@using Nuvora.Decisions.Contracts.Goldens
@using Nuvora.Decisions.Contracts.Kinds
@implements IDisposable

<div class="wb-root" lang="@LangCode">
    <div class="wb-main" inert="@DialogOpen">
        <div class="wb-panel wb-list-panel">
            <div class="wb-ph">
                <h2 class="wb-title">@Rich("list.title")</h2>
                @if (Rules is not null)
                {
                    <div class="wb-meta">@CountLine()</div>
                }
            </div>
            @if (Rules is null)
            {
                <div class="wb-skeletons" aria-hidden="true">
                    <div class="wb-skeleton"></div>
                    <div class="wb-skeleton"></div>
                    <div class="wb-skeleton"></div>
                </div>
            }
            else if (Rules.Count > 0)
            {
                var selectedKey = SelectedRule?.Key;
                <div class="wb-list-select-wrap">
                    <select class="wb-in wb-list-select" aria-label="@Plain("list.aria")" value="@(Rules.ToList().FindIndex(item => item.Key == selectedKey).ToString(CultureInfo.InvariantCulture))" @onchange="SelectFromList">
                        @for (var position = 0; position < Rules.Count; position++)
                        {
                            <option value="@position.ToString(CultureInfo.InvariantCulture)">@TitleOf(Rules[position])</option>
                        }
                    </select>
                </div>
                <nav class="wb-list" aria-label="@Plain("list.aria")">
                    @foreach (var group in RuleGroups())
                    {
                        <section class="wb-group-section">
                            @if (group.Heading is not null)
                            {
                                <h3 class="wb-group" id="@(idp + "-g" + group.Number)">@group.Heading</h3>
                            }
                            <ul class="wb-rules" aria-labelledby="@(group.Heading is not null ? idp + "-g" + group.Number : null)">
                                @foreach (var entry in group.Entries)
                                {
                                    var rule = entry.Rule;
                                    var index = entry.Index;
                                    var selected = string.Equals(rule.Key, selectedKey, StringComparison.Ordinal);
                                    <li>
                                        <button type="button" class="wb-rule" aria-current="@(selected ? "true" : null)" @onclick="() => SelectRule(rule.Key)" @onkeydown="OnListKeyDown" @ref="refs[RuleRef(index)]">
                                            <span class="wb-rule-t">
                                                <span class="wb-rule-name">@TitleOf(rule)</span>
                                                @if (IsReadable(rule))
                                                {
                                                    <span class="@PillClass(rule.State == RuleApprovalState.Approved ? "ok" : "warn")">@Rich(rule.State == RuleApprovalState.Approved ? "state.approved" : "state.draft")</span>
                                                }
                                                else
                                                {
                                                    <span class="@PillClass("neutral")">@Rich("list.unreadable")</span>
                                                }
                                            </span>
                                            @if (IsReadable(rule))
                                            {
                                                <span class="wb-rule-s">@ListSummary(rule)</span>
                                            }
                                        </button>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </nav>
            }
        </div>

        <div class="wb-panel wb-detail">
            @if (Rules is null)
            {
                <div class="wb-body wb-sub" role="status">@Rich("load.loading")</div>
            }
            else if (Rules.Count == 0)
            {
                <div class="wb-body wb-sub">@Rich("list.empty")</div>
            }
            else if (SelectedRule is { } current)
            {
                @DetailPanel(current)
            }
        </div>
    </div>
    @if (DialogOpen && SelectedRule is { } asked)
    {
        @DiscardDialog(asked)
    }
</div>

@code {
    private static readonly (ReviewState State, string Key, string PressedKey)[] ReviewParts =
    [
        (ReviewState.Confirmed, "review.confirm", "review.confirmed"),
        (ReviewState.NeedsFix, "review.fix", "review.fixState"),
        (ReviewState.Question, "review.question", "review.questionState"),
    ];

    private static readonly (WorkbenchTab Tab, string Key)[] TabKeys =
    [
        (WorkbenchTab.Read, "tabs.read"),
        (WorkbenchTab.Simulate, "tabs.simulate"),
        (WorkbenchTab.Tests, "tabs.tests"),
        (WorkbenchTab.Review, "tabs.review"),
        (WorkbenchTab.Changes, "tabs.changes"),
    ];

    private RenderFragment BrokenNote() => @<div class="wb-sub" role="status">@Rich("draft.unreadable.fix")</div>;

    private RenderFragment PrivacyNotice() => @<div class="wb-notice" role="note">@Rich("notice.privacy")</div>;

    private RenderFragment Band(string key, bool onDraft = false) => @<div class="wb-band"><span class="@PillClass("sim")">@Rich("pill.simulation")</span><span>@if (onDraft){<strong>@Rich(key + "Draft")</strong>@(" ")}@Rich(key)</span></div>;

    private RenderFragment DetailPanel(WorkbenchRule rule)
    {
        if (!IsReadable(rule))
        {
            return @<text>
                <div class="wb-ph">
                    <div class="wb-head"><h1 class="wb-title">@TitleOf(rule)</h1><span class="@PillClass("neutral")">@Rich("list.unreadable")</span></div>
                </div>
                <div class="wb-body wb-sub" role="status">@Rich("load.failedBody")</div>
            </text>;
        }

        var ctx = Context(rule);
        var work = ctx.Work;
        var run = ctx.Run;
        var exportedItems = work.Reviews.Values.Count(entry => entry.IsExported);
        var changing = ChangingCount(ctx);
        var changeCount = ctx.Draft is null ? 0 : ChangeCount(rule, ctx.Draft);
        var current = Session.SelectedTab == WorkbenchTab.Changes && ctx.Draft is null ? WorkbenchTab.Read : Session.SelectedTab;

        return @<text>
            <div class="wb-ph">
                <div class="wb-head">
                    <h1 class="wb-title">@TitleOf(rule)</h1>
                    <span class="@PillClass(rule.State == RuleApprovalState.Approved ? "ok" : "warn")">@Rich(rule.State == RuleApprovalState.Approved ? "state.approved" : "state.draft")</span>
                    <span class="wb-sp"></span>
                    <span class="wb-meta">@Rich("panel.version", ("n", rule.Rule!.Version.ToString(CultureInfo.InvariantCulture)))</span>
                    @if (rule.CanDraft)
                    {
                        <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => ToggleDraft(rule)" @ref="refs[DraftToggleRef]">@Rich(ctx.Draft is null ? "draft.start" : "draft.discard")</button>
                    }
                </div>
                <div class="wb-meta">@StateLineOf(rule)@if (!string.IsNullOrWhiteSpace(rule.SourceLine)){@(" " + rule.SourceLine)}</div>
                <div class="wb-meta wb-small">@Rich("state.elsewhere")</div>
            </div>
            @if (ctx.Draft is { } draft)
            {
                @DraftBar(rule, draft)
            }
            <div class="wb-tabs" role="tablist" aria-label="@Plain("tabs.label")">
                @foreach (var entry in TabKeys.Where(item => item.Tab != WorkbenchTab.Changes || ctx.Draft is not null))
                {
                    var tab = entry.Tab;
                    var number = (int)tab;
                    var on = tab == current;
                    <button type="button" role="tab" id="@(idp + "-tab-" + number)" class="wb-tab" aria-selected="@(on ? "true" : "false")" aria-controls="@(idp + "-panel")" tabindex="@(on ? 0 : -1)" @onclick="() => SelectTab(tab)" @onkeydown="OnTabKeyDown" @ref="refs[TabRef(number)]">
                        @Rich(entry.Key)
                        @if (tab == WorkbenchTab.Tests && changing > 0)
                        {
                            <span class="wb-pill wb-pill-n wb-pill-bad">@PluralText("tabs.casesChange", changing)</span>
                        }
                        else if (tab == WorkbenchTab.Tests && run.Cases.Count > 0)
                        {
                            <span class="@(run.FailedCount > 0 ? "wb-pill wb-pill-n wb-pill-bad" : "wb-pill wb-pill-n")">@(run.FailedCount > 0 ? PluralText("fail.count", run.FailedCount) : OutcomeFormat.Number(run.Cases.Count))</span>
                        }
                        @if (tab == WorkbenchTab.Changes && changeCount > 0)
                        {
                            <span class="wb-pill wb-pill-n">@OutcomeFormat.Number(changeCount)</span>
                        }
                        @if (tab == WorkbenchTab.Review && exportedItems > 0)
                        {
                            <span class="wb-pill wb-pill-n">@OutcomeFormat.Number(exportedItems)</span>
                        }
                    </button>
                }
            </div>
            <div class="wb-body" role="tabpanel" id="@(idp + "-panel")" aria-labelledby="@(idp + "-tab-" + (int)current)" tabindex="0">
                @switch (current)
                {
                    case WorkbenchTab.Read:
                        @ReadPanel(ctx)
                        break;
                    case WorkbenchTab.Simulate:
                        @SimulatePanel(ctx)
                        break;
                    case WorkbenchTab.Tests:
                        @TestsPanel(ctx)
                        break;
                    case WorkbenchTab.Changes:
                        @ChangesPanel(Context(rule, forceDraft: true))
                        break;
                    default:
                        @ReviewPanel(Context(rule, baseOnly: true))
                        break;
                }
            </div>
        </text>;
    }

    // ----- draft bar and dialog ---------------------------------------------------------------------------------------

    private RenderFragment DraftBar(WorkbenchRule rule, DraftState draft) => @<div class="wb-draftbar" role="note">
        <span class="wb-pill wb-pill-draft">@Rich("pill.draft")</span>
        <span class="wb-draftbar-t">@DraftSentence(rule, draft)</span>
        <div class="wb-switch" role="group" aria-label="@Plain("draft.switch")">
            <button type="button" class="wb-switch-part" aria-pressed="@(draft.ViewDraft ? "false" : "true")" @onclick="() => SetView(rule, false)">@Rich("draft.view.rule")</button>
            <button type="button" class="wb-switch-part" aria-pressed="@(draft.ViewDraft ? "true" : "false")" @onclick="() => SetView(rule, true)">@Rich("draft.view.draft")</button>
        </div>
    </div>;

    private RenderFragment DiscardDialog(WorkbenchRule rule)
    {
        var draft = Session.Work(rule.Key).Draft!;
        var rows = PluralText("discard.rows", ChangeCount(rule, draft));
        var cases = PluralText("discard.cases", draft.CaseStepCount);
        return @<div class="wb-scrim">
            <div class="wb-dialog" role="dialog" aria-modal="true" aria-labelledby="@(idp + "-dlg-t")" aria-describedby="@(idp + "-dlg-b")" @onkeydown="OnDialogKeyDown">
                <h2 class="wb-h2" id="@(idp + "-dlg-t")">@Rich("discard.title")</h2>
                <p class="wb-dialog-body" id="@(idp + "-dlg-b")">@Rich("discard.body", ("rows", rows), ("cases", cases))</p>
                <div class="wb-actions">
                    <button type="button" class="wb-btn wb-btn-secondary" @onclick="() => Discard(rule)">@Rich("discard.confirm")</button>
                    <button type="button" class="wb-btn wb-btn-primary" @onclick="CloseDialog" @ref="refs[KeepRef]">@Rich("discard.keep")</button>
                </div>
            </div>
        </div>;
    }

    /// <summary>The box that stands in for the rows of a draft the loader cannot read, with the reasons and the two ways out.</summary>
    private RenderFragment UnreadableBox(Ctx c)
    {
        var draft = c.Draft!;
        var lines = DraftWording.Lines(text, draft.Problems, c.View, null, EmptyWords);
        return @<div class="wb-refusal" role="alert">
            <h2 class="wb-h2 wb-h2-flush">@Rich("draft.unreadable.title")</h2>
            <ul class="wb-refusal-list">
                @foreach (var line in lines)
                {
                    <li>@line</li>
                }
            </ul>
            <div class="wb-actions wb-actions-tight">
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" disabled="@(!draft.HasChanges)" @onclick="() => UndoLast(c.Rule, draft)">@Rich("draft.unreadable.undo")</button>
                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => ToggleDraft(c.Rule)">@Rich("draft.discard")</button>
            </div>
        </div>;
    }

    // ----- shared pieces ----------------------------------------------------------------------------------------------

    private RenderFragment ReviewControl(RuleWork work, string target, string groupLabel) => @<div class="wb-rv" role="group" aria-label="@groupLabel">
        @foreach (var part in ReviewParts)
        {
            var state = part.State;
            var pressed = work.Review(target).State == state;
            <button type="button" class="wb-seg-part" aria-pressed="@(pressed ? "true" : "false")" @onclick="() => ToggleReview(work, target, state)">@Rich(pressed ? part.PressedKey : part.Key)</button>
        }
    </div>;

    private RenderFragment MissingNote(RuleWork work, string target) => @<span class="wb-missing-note"><span class="wb-missing">@Rich("review.noteMissing")</span> <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => WriteNote(work, target)">@Rich("review.writeNote")</button></span>;

    private RenderFragment NoteEditor(RuleWork work, string target, string labelKey)
    {
        var entry = work.Review(target);
        if (!NoteVisible(work, target))
        {
            return entry.State == ReviewState.Confirmed
                ? @<button type="button" class="wb-link" @onclick="() => OpenNote(work, target)">@Rich("review.addNote")</button>
                : @<text></text>;
        }

        var id = NoteId(target);
        return @<div class="wb-card wb-note">
            <label class="wb-label" for="@id">@Rich(labelKey)</label>
            <textarea id="@id" class="wb-in" rows="2" maxlength="@NoteMax" value="@entry.Note" @onchange="args => SetNote(work, target, args.Value?.ToString())" @ref="refs[NoteRef(target)]"></textarea>
            @if (entry.Note.Length >= NoteCounterFrom)
            {
                <div class="wb-hint">@Plain("review.counter", ("n", OutcomeFormat.Number(entry.Note.Length)), ("max", OutcomeFormat.Number(NoteMax)))</div>
            }
        </div>;
    }

    private RenderFragment FactFields(BrainRule brain, FactForm form, IReadOnlyList<ShownFact> shown, string scope, Action? changed) => @<text>
        @foreach (var item in shown)
        {
            var fact = item.Fact;
            var name = fact.Name;
            var fieldId = idp + "-" + scope + "-" + item.Index.ToString(CultureInfo.InvariantCulture);
            var currencies = fact.Type == FactType.Money ? FactForm.CurrencyOptions(brain, name, form.CurrencyOf(name)) : [];
            var hint = HintText(fact, currencies);
            var error = form.Errors.TryGetValue(name, out var code) ? ErrorKey(code) : null;
            var hintId = fieldId + "-hint";
            var errorId = fieldId + "-err";
            var describedBy = string.Join(' ', new[] { hint.Length > 0 ? hintId : null, error is not null ? errorId : null }.OfType<string>());
            var inputClass = error is null ? "wb-in" : "wb-in wb-in-err";
            var invalid = error is null ? null : "true";
            <div class="wb-field">
                @if (fact.Type == FactType.Boolean)
                {
                    var choices = BooleanChoices(fact);
                    <span class="wb-label" id="@(fieldId + "-label")">@item.View.Label</span>
                    <div class="wb-radios" role="radiogroup" aria-labelledby="@(fieldId + "-label")" aria-describedby="@(describedBy.Length > 0 ? describedBy : null)" aria-invalid="@invalid">
                        @for (var position = 0; position < choices.Count; position++)
                        {
                            var choice = choices[position];
                            var slot = position;
                            <label class="wb-radio"><input type="radio" name="@(fieldId + "-r")" value="@choice.Value" checked="@(form.TextOf(name) == choice.Value)" @onchange="args => SetField(form, name, args, changed)" @ref="refs[FieldSlotRef(scope, item.Index, slot)]" />@choice.Label</label>
                        }
                    </div>
                }
                else
                {
                    <label class="wb-label" for="@fieldId">@item.View.Label</label>
                    @if (fact.Type == FactType.Enum && item.View.AllowedValues.Count > 0)
                    {
                        <select id="@fieldId" class="@inputClass" value="@form.TextOf(name)" aria-describedby="@(describedBy.Length > 0 ? describedBy : null)" aria-invalid="@invalid" @onchange="args => SetField(form, name, args, changed)" @ref="refs[FieldRef(scope, item.Index)]">
                            @if (fact.Nullable)
                            {
                                <option value="">@Plain("sim.noValue")</option>
                            }
                            @foreach (var option in item.View.AllowedValues)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    }
                    else if (fact.Type == FactType.Date)
                    {
                        <input id="@fieldId" type="date" lang="@LangCode" class="@inputClass" value="@form.TextOf(name)" aria-describedby="@(describedBy.Length > 0 ? describedBy : null)" aria-invalid="@invalid" @onchange="args => SetField(form, name, args, changed)" @ref="refs[FieldRef(scope, item.Index)]" />
                    }
                    else if (fact.Type == FactType.Money)
                    {
                        <div class="wb-money">
                            <input id="@fieldId" type="text" inputmode="decimal" autocomplete="off" class="@inputClass" aria-label="@Plain("sim.amount")" value="@form.TextOf(name)" aria-describedby="@(describedBy.Length > 0 ? describedBy : null)" aria-invalid="@invalid" @onchange="args => SetField(form, name, args, changed)" @ref="refs[FieldRef(scope, item.Index)]" />
                            <select class="@(inputClass + " wb-in-currency")" aria-label="@Plain("sim.currency")" value="@form.CurrencyChoice(name)" aria-describedby="@(describedBy.Length > 0 ? describedBy : null)" aria-invalid="@invalid" @onchange="args => SetCurrency(form, name, args, changed)">
                                @foreach (var currency in currencies)
                                {
                                    <option value="@currency">@(currency)</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input id="@fieldId" type="text" autocomplete="off" inputmode="@InputMode(fact.Type)" class="@inputClass" value="@form.TextOf(name)" aria-describedby="@(describedBy.Length > 0 ? describedBy : null)" aria-invalid="@invalid" @onchange="args => SetField(form, name, args, changed)" @ref="refs[FieldRef(scope, item.Index)]" />
                    }
                }
                @if (hint.Length > 0)
                {
                    <div class="wb-hint" id="@hintId">@hint</div>
                }
                @if (error is not null)
                {
                    <div class="wb-errt" id="@errorId">@Rich(error)</div>
                }
            </div>
        }
    </text>;

    private string HintText(FactDescriptor fact, IReadOnlyList<string> currencies)
    {
        var parts = new List<string>();
        var type = fact.Type switch
        {
            FactType.Integer => "hint.integer",
            FactType.Decimal => "hint.decimal",
            FactType.Money => currencies.Count > 1 ? "hint.money" : "hint.moneyUsd",
            _ => null,
        };
        if (type is not null)
        {
            parts.Add(Plain(type));
        }

        if (!fact.Nullable)
        {
            parts.Add(Plain("hint.required"));
        }

        return string.Join(' ', parts);
    }

    private static string ErrorKey(string code) => code switch
    {
        FactInput.ErrorRequired => "err.required",
        FactInput.ErrorNotAllowed => "err.notAllowed",
        FactInput.ErrorNotABoolean => "err.notBoolean",
        FactInput.ErrorNotAnInteger => "err.notInteger",
        FactInput.ErrorNotADecimal => "err.notDecimal",
        FactInput.ErrorNotADate => "err.notDate",
        FactInput.ErrorNotMoney => "err.notMoney",
        _ => "err.generic",
    };

    private List<(string Value, string Label)> BooleanChoices(FactDescriptor fact)
    {
        var choices = new List<(string Value, string Label)> { ("true", Plain("sim.yes")), ("false", Plain("sim.no")) };
        if (fact.Nullable)
        {
            choices.Add((string.Empty, Plain("sim.noValue")));
        }

        return choices;
    }

    // ----- Read -------------------------------------------------------------------------------------------------------

    private RenderFragment ReadPanel(Ctx c)
    {
        if (c.Broken)
        {
            return UnreadableBox(c);
        }

        return c.Editing ? DraftReadPanel(c) : RuleReadPanel(c);
    }

    private RenderFragment FactsBlock(Ctx c) => @<text>
        <h2 class="wb-h2 wb-h2-gap">@Rich("read.facts")</h2>
        <dl class="wb-kv">
            @foreach (var fact in c.View.Facts)
            {
                <dt>@fact.Label</dt>
                <dd>@TypeWord(fact) · @Rich(fact.Nullable ? "read.optional" : "read.required")</dd>
            }
        </dl>
    </text>;

    private RenderFragment DraftReadPanel(Ctx c)
    {
        var draft = c.Draft!;
        var readOnly = IsStale(c.Rule, draft);
        var items = DraftItems(c);
        var form = readOnly ? null : draft.Form;
        var catalog = form is null ? null : RuleChoiceCatalog.For(c.Brain, c.Labels, Locale);
        var findings = draft.Findings!;
        var unreachable = findings.Unreachable.Where(key => !draft.BaseFindings.Unreachable.Contains(key)).ToHashSet(StringComparer.Ordinal);
        var incomplete = findings.Incomplete && !draft.BaseFindings.Incomplete;
        var defaultKey = c.Brain.Table.DefaultRow?.Key;
        var defaultChanged = ChangesOf(c.Rule, draft).DefaultRowChanged;
        var changingCases = readOnly ? 0 : ChangingCount(c);
        return @<text>
            <div class="wb-sr" role="status" aria-live="polite">@liveMessage</div>
            @if (changingCases > 0)
            {
                <div class="wb-notice wb-notice-gap wb-notice-act" role="note">
                    <span>@Rich(UiText.Plural("read.casesNotice", changingCases), ("n", OutcomeFormat.Number(changingCases)))</span>
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => SeeChangingCases(c)">@Rich(UiText.Plural("read.casesSee", changingCases))</button>
                </div>
            }
            <h2 class="wb-h2">@Rich(PolicyKey(c.View.HitPolicy))</h2>
            @if (draft.Refusal is { RowKey: null } top)
            {
                @RefusalBox(top.Lines, false)
            }
            @if (incomplete)
            {
                <div class="wb-notice wb-notice-gap" role="note">@Rich("edit.incomplete")</div>
            }
            @if (form is { IsNew: true, AfterKey: null })
            {
                @RowFormPanel(c, form, catalog!)
            }
            @foreach (var item in items)
            {
                @DraftRow(c, item, form, catalog, readOnly, unreachable)
                @if (form is { IsNew: true } added && item.Row is not null && string.Equals(added.AfterKey, item.Key, StringComparison.Ordinal))
                {
                    @RowFormPanel(c, form, catalog!)
                }
            }
            @if (!readOnly)
            {
                <div class="wb-row-add">
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => AddAtEnd(c)" @ref="refs[AddEndRef]">@Rich(items.Count == 0 ? "row.addFirst" : "row.addEnd")</button>
                </div>
            }
            @if (c.View.DefaultRow is { } fallback)
            {
                @if (form is { IsDefault: true })
                {
                    @RowFormPanel(c, form, catalog!)
                }
                else
                {
                    <div class="wb-row wb-row-default">
                        <span class="wb-num">@SimulationPresenter.Number(fallback)</span>
                        <div><div class="wb-sent">@fallback.Sentence</div></div>
                        <div class="wb-rowctl">
                            @if (defaultChanged)
                            {
                                <span class="@PillClass("warn")">@Rich("tag.changed")</span>
                                @if (!readOnly)
                                {
                                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("row.undoFor", ("n", "–"))" @onclick="() => UndoRow(c, defaultKey!, step => step.Key == defaultKey && step.Kind == StepKind.Row)">@Rich("row.undo")</button>
                                }
                            }
                            @if (!readOnly)
                            {
                                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("form.titleDefault")" @onclick="() => OpenEdit(c, defaultKey!, true)" @ref="refs[EditRef(defaultKey!)]">@Rich("row.edit")</button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="wb-row wb-row-default">
                    <span class="wb-num">–</span>
                    <div><div class="wb-sent">@Rich("read.noDefaultRow")</div></div>
                    <span></span>
                </div>
            }
            @FactsBlock(c)
        </text>;
    }

    private RenderFragment DraftRow(Ctx c, DraftItem item, RowForm? form, RuleChoices? catalog, bool readOnly, HashSet<string> unreachable)
    {
        var draft = c.Draft!;
        var key = item.Key;
        if (form is { IsNew: false, IsDefault: false } && item.Row is not null && string.Equals(form.RowKey, key, StringComparison.Ordinal))
        {
            return RowFormPanel(c, form, catalog!);
        }

        var row = item.Row;
        var removed = row is null;
        var tag = item.Change?.Tag;
        var moved = tag == RowChangeTag.Moved || IsMoved(draft, item);
        var number = removed ? string.Empty : SimulationPresenter.Number(row!);
        var rows = c.View.Rows;
        var position = removed ? -1 : row!.Index;
        var open = menuFor == key;
        var entries = new (string Key, bool Enabled, Action Run)[]
        {
            ("row.up", position > 0, () => MoveRow(c, key, -1)),
            ("row.down", position >= 0 && position < rows.Count - 1, () => MoveRow(c, key, 1)),
            ("row.addBelow", true, () => AddBelow(c, key)),
            ("row.remove", true, () => RemoveRowAction(c, key)),
        };
        var enabledAt = entries.Select((entry, index) => (entry, index)).Where(pair => pair.entry.Enabled).Select(pair => pair.index).ToList();
        return @<div>
            <div class="@(removed ? "wb-row wb-row-removed" : "wb-row")">
                <span class="wb-num">@number</span>
                <div>
                    @if (row?.Title is { } title)
                    {
                        <div class="wb-row-title">@title</div>
                    }
                    <div class="@(removed ? "wb-sent wb-struck" : "wb-sent")">@(removed ? item.Change!.SentenceBefore : row!.Sentence)</div>
                    @if (tag == RowChangeTag.Changed && item.Change?.SentenceBefore is { } before)
                    {
                        <div class="wb-sub"><span class="wb-before">@Rich("row.before")</span> @before</div>
                    }
                    @if (moved && item.Change?.NumberBefore is { } was && item.Change.NumberAfter != was)
                    {
                        <div class="wb-sub">@Rich("row.wasRow", ("n", was.ToString(CultureInfo.InvariantCulture)))</div>
                    }
                </div>
                <div class="wb-rowctl">
                    @if (tag is { } shown)
                    {
                        <span class="@PillClass(TagTone(shown))">@Rich(TagKey(shown == RowChangeTag.Moved ? RowChangeTag.Moved : shown))</span>
                    }
                    @if (moved && tag == RowChangeTag.Changed)
                    {
                        <span class="@PillClass("neutral")">@Rich("tag.moved")</span>
                    }
                    @if (!readOnly)
                    {
                        @if (removed)
                        {
                            <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => UndoRow(c, key, step => step.Kind == StepKind.Remove && step.Key == key)" @ref="refs[RestoreRef(key)]">@Rich("row.restore")</button>
                        }
                        else
                        {
                            @if (tag is RowChangeTag.Changed or RowChangeTag.Moved && HasRowSteps(draft, key))
                            {
                                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("row.undoFor", ("n", number))" @onclick="() => UndoRow(c, key, step => step.Key == key && step.Kind is StepKind.Row or StepKind.Move)">@Rich("row.undo")</button>
                            }
                            <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("row.editFor", ("n", number))" @onclick="() => OpenEdit(c, key, false)" @ref="refs[EditRef(key)]">@Rich("row.edit")</button>
                            <span class="wb-menuwrap">
                                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-haspopup="menu" aria-expanded="@(open ? "true" : "false")" aria-label="@Plain("row.moreFor", ("n", number))" @onclick="() => ToggleMenu(key, enabledAt[0])" @ref="refs[MoreRef(key)]">@Rich("row.more")</button>
                                @if (open)
                                {
                                    <div class="wb-menu" role="menu" aria-label="@Plain("row.moreFor", ("n", number))">
                                        @for (var index = 0; index < entries.Length; index++)
                                        {
                                            var at = index;
                                            var entry = entries[index];
                                            <button type="button" role="menuitem" class="wb-menu-i" disabled="@(!entry.Enabled)" @onclick="entry.Run" @onkeydown="args => OnMenuKey(args, key, enabledAt, at)" @ref="refs[MenuItemRef(key, at)]">@Rich(entry.Key)</button>
                                        }
                                    </div>
                                }
                            </span>
                        }
                    }
                </div>
            </div>
            @if (!removed && unreachable.Contains(key))
            {
                <div class="wb-notice wb-notice-row" role="note">@Rich("edit.unreachable", ("n", number))</div>
            }
            @if (draft.Refusal is { } refusal && string.Equals(refusal.RowKey, key, StringComparison.Ordinal))
            {
                @RefusalBox(refusal.Lines, false)
            }
        </div>;
    }

    private RenderFragment RefusalBox(IReadOnlyList<string> lines, bool internalOnly) => @<div class="wb-refusal" role="alert" tabindex="-1" @ref="refs[BoxRef]">
        <div class="wb-refusal-t">@Rich("refuse.edit.title")</div>
        <ul class="wb-refusal-list">
            @foreach (var line in lines)
            {
                <li>@line</li>
            }
        </ul>
        @if (!internalOnly)
        {
            <div class="wb-refusal-stays">@Rich("refuse.edit.stays")</div>
        }
    </div>;

    private RenderFragment RowFormPanel(Ctx c, RowForm form, RuleChoices catalog)
    {
        var titleId = idp + "-ft";
        var title = TitleOf(form);
        var hidden = form.IsDefault ? 0 : c.Shown.Count(item => !FactVisible(form, item.Fact.Name));
        var nameId = idp + "-fname";
        return @<div class="wb-rowform" role="group" aria-labelledby="@titleId">
            <h3 class="wb-h2 wb-h2-flush" id="@titleId">@title</h3>
            @if (!form.IsDefault)
            {
                <div class="wb-fsec">@Rich("form.when")</div>
                @foreach (var item in c.Shown.Where(item => FactVisible(form, item.Fact.Name)))
                {
                    @FactLineFragment(c, form, item, catalog.Facts.First(choice => choice.Fact == item.Fact.Name))
                }
                @if (hidden > 0)
                {
                    <button type="button" class="wb-link" @onclick="() => ShowUnused(form)">@Rich(UiText.Plural("form.unused", hidden), ("n", OutcomeFormat.Number(hidden)))</button>
                }
            }
            <div class="wb-fsec">@Rich("form.then")</div>
            @foreach (var field in c.Brain.Kind.OutcomeFields)
            {
                @OutcomeLine(c, form, field)
            }
            @if (!form.IsDefault)
            {
                <div class="wb-fline wb-fline-out">
                    <label class="wb-flabel" for="@nameId">@Rich("form.name") <span class="wb-hint-inline">· @Rich("form.optional")</span></label>
                    <div class="wb-fvalue"><input id="@nameId" type="text" autocomplete="off" maxlength="60" class="wb-in" value="@form.Name" @onchange="args => SetRowName(c, form, args)" /></div>
                </div>
            }
            <div class="wb-preview">
                <div class="wb-fsec">@Rich("form.preview")</div>
                <div class="wb-preview-t" aria-live="polite">@(form.Preview.Length > 0 ? form.Preview : "–")</div>
            </div>
            @foreach (var warning in form.Warnings)
            {
                <div class="wb-notice wb-notice-row" role="note">@warning</div>
            }
            @if (form.Refusal is { } refusal)
            {
                @RefusalBox(refusal.Lines, form.RefusalIsInternal)
            }
            @if (form.Blocked.Length > 0)
            {
                <div class="wb-sub" role="status">@form.Blocked</div>
            }
            <div class="wb-actions">
                <button type="button" class="wb-btn wb-btn-primary" @onclick="() => ApplyForm(c)">@Rich("form.apply")</button>
                <button type="button" class="wb-btn wb-btn-secondary" @onclick="() => CancelForm(c)">@Rich("form.cancel")</button>
            </div>
        </div>;
    }

    private RenderFragment FactLineFragment(Ctx c, RowForm form, ShownFact item, FactChoices choices)
    {
        var name = item.Fact.Name;
        var line = form.LineFor(name);
        var key = "fact:" + name;
        var id = idp + "-fl-" + item.Index.ToString(CultureInfo.InvariantCulture);
        var problem = form.Problems.GetValueOrDefault(key);
        var invalid = problem is not null || form.Marked.Contains(key);
        var wordings = RowForm.WordingsFor(choices);
        return @<div class="wb-fline">
            <span class="wb-flabel">@item.View.Label</span>
            <select id="@(id + "-op")" class="@(invalid ? "wb-in wb-in-err" : "wb-in")" aria-label="@Plain("form.opLabel", ("fact", item.View.Label))" aria-invalid="@(invalid ? "true" : null)" value="@line.Wording" @onchange="args => SetWording(c, form, item, args)" @ref="refs[FactCtlRef(name)]">
                @foreach (var wording in wordings)
                {
                    <option value="@wording">@Rich("op." + wording)</option>
                }
            </select>
            <div class="wb-fvalue">
                @ValueInputs(c, form, item, line, id, invalid)
                @if (problem is not null)
                {
                    <div class="wb-errt" role="alert">@ProblemText(c, key, problem)</div>
                }
            </div>
        </div>;
    }

    private RenderFragment ValueInputs(Ctx c, RowForm form, ShownFact item, FactLine line, string id, bool invalid)
    {
        var wording = line.Wording;
        if (RowForm.TakesNoValue(wording))
        {
            return @<text></text>;
        }

        if (RowForm.IsSet(wording))
        {
            return item.Fact.Type == FactType.Enum && item.View.AllowedValues.Count > 0 ? SetChecks(c, form, item, line) : SetChips(c, form, item, line, invalid);
        }

        if (wording == "between")
        {
            return @<div class="wb-between">
                @SingleInput(c, form, item, line, id + "-a", false, Plain("form.from"), invalid)
                <span>@Rich("form.and")</span>
                @SingleInput(c, form, item, line, id + "-b", true, Plain("form.to"), invalid)
            </div>;
        }

        return SingleInput(c, form, item, line, id + "-a", false, Plain("form.valLabel", ("fact", item.View.Label)), invalid);
    }

    private RenderFragment SetChecks(Ctx c, RowForm form, ShownFact item, FactLine line) => @<fieldset class="wb-checks">
        <legend class="wb-sr">@Plain("form.valLabel", ("fact", item.View.Label))</legend>
        @foreach (var option in item.View.AllowedValues)
        {
            <label class="wb-radio"><input type="checkbox" checked="@line.Items.Contains(option.Value, StringComparer.Ordinal)" @onchange="args => ToggleItem(c, form, item.Fact.Name, option.Value, args.Value is true)" />@option.Label</label>
        }
    </fieldset>;

    private RenderFragment SetChips(Ctx c, RowForm form, ShownFact item, FactLine line, bool invalid) => @<div class="wb-chips">
        @foreach (var chip in line.Items)
        {
            <span class="wb-chip">@chip<button type="button" class="wb-chip-x" aria-label="@Plain("form.chipRemove", ("value", chip))" @onclick="() => RemoveChip(c, form, item.Fact.Name, chip)">×</button></span>
        }
        <input type="text" autocomplete="off" class="@(invalid ? "wb-in wb-in-err" : "wb-in")" aria-label="@Plain("form.chipLabel", ("fact", item.View.Label))" value="@line.ChipText" @onchange="args => AddChip(c, form, item.Fact.Name, args)" />
    </div>;

    private RenderFragment SingleInput(Ctx c, RowForm form, ShownFact item, FactLine line, string id, bool upper, string label, bool invalid)
    {
        var fact = item.Fact;
        var name = fact.Name;
        var value = upper ? line.Upper : line.Value;
        var inputClass = invalid ? "wb-in wb-in-err" : "wb-in";
        if (fact.Type == FactType.Boolean || (fact.Type == FactType.Enum && item.View.AllowedValues.Count > 0))
        {
            var options = fact.Type == FactType.Boolean
                ? new List<(string Value, string Label)> { ("true", Plain("sim.yes")), ("false", Plain("sim.no")) }
                : [.. item.View.AllowedValues.Select(option => (option.Value, option.Label))];
            return @<select id="@id" class="@inputClass" aria-label="@label" value="@value" @onchange="args => SetLineText(c, form, name, upper, args)">
                @foreach (var option in options)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>;
        }

        if (fact.Type == FactType.Date)
        {
            return @<input id="@id" type="date" lang="@LangCode" class="@inputClass" aria-label="@label" value="@value" @onchange="args => SetLineText(c, form, name, upper, args)" />;
        }

        if (fact.Type == FactType.Money)
        {
            var currencies = FactForm.CurrencyOptions(c.Brain, name, line.Currency);
            return @<div class="wb-money">
                <input id="@id" type="text" inputmode="decimal" autocomplete="off" class="@inputClass" aria-label="@label" value="@value" @onchange="args => SetLineText(c, form, name, upper, args)" />
                @if (!upper)
                {
                    <select class="@(inputClass + " wb-in-currency")" aria-label="@Plain("sim.currency")" value="@line.Currency" @onchange="args => SetLineCurrency(c, form, name, args)">
                        @foreach (var currency in currencies)
                        {
                            <option value="@currency">@currency</option>
                        }
                    </select>
                }
            </div>;
        }

        return @<input id="@id" type="text" autocomplete="off" inputmode="@InputMode(fact.Type)" class="@inputClass" aria-label="@label" value="@value" @onchange="args => SetLineText(c, form, name, upper, args)" />;
    }

    private RenderFragment OutcomeLine(Ctx c, RowForm form, OutcomeFieldDescriptor field)
    {
        var name = field.Name;
        var label = c.View.OutcomeFields.First(item => item.Name == name).Label;
        var key = "out:" + name;
        var id = idp + "-fo-" + name.GetHashCode(StringComparison.Ordinal).ToString("x", CultureInfo.InvariantCulture);
        var problem = form.Problems.GetValueOrDefault(key);
        var invalid = problem is not null || form.Marked.Contains(key);
        var inputClass = invalid ? "wb-in wb-in-err" : "wb-in";
        var choices = OutcomeChoicesOf(c, field);
        var current = form.Outcome.GetValueOrDefault(name, string.Empty);
        return @<div class="wb-fline wb-fline-out">
            <label class="wb-flabel" for="@id">@label</label>
            <div class="wb-fvalue">
                @if (choices is not null)
                {
                    <select id="@id" class="@inputClass" aria-invalid="@(invalid ? "true" : null)" value="@current" @onchange="args => SetOutcomeText(c, form, name, args)" @ref="refs[OutCtlRef(name)]">
                        @foreach (var option in choices)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                }
                else if (field.Type == FactType.Money)
                {
                    <div class="wb-money">
                        <input id="@id" type="text" inputmode="decimal" autocomplete="off" class="@inputClass" aria-invalid="@(invalid ? "true" : null)" value="@current" @onchange="args => SetOutcomeText(c, form, name, args)" @ref="refs[OutCtlRef(name)]" />
                        <select class="@(inputClass + " wb-in-currency")" aria-label="@Plain("sim.currency")" value="@form.OutcomeCurrency.GetValueOrDefault(name, FactForm.DefaultCurrency)" @onchange="args => SetOutcomeCurrency(c, form, name, args)">
                            @foreach (var currency in FactForm.CurrencyOptions(c.Brain, name, form.OutcomeCurrency.GetValueOrDefault(name, string.Empty)))
                            {
                                <option value="@currency">@currency</option>
                            }
                        </select>
                    </div>
                }
                else if (field.Type == FactType.Date)
                {
                    <input id="@id" type="date" lang="@LangCode" class="@inputClass" aria-invalid="@(invalid ? "true" : null)" value="@current" @onchange="args => SetOutcomeText(c, form, name, args)" @ref="refs[OutCtlRef(name)]" />
                }
                else
                {
                    <input id="@id" type="text" autocomplete="off" inputmode="@InputMode(field.Type)" class="@inputClass" aria-invalid="@(invalid ? "true" : null)" value="@current" @onchange="args => SetOutcomeText(c, form, name, args)" @ref="refs[OutCtlRef(name)]" />
                }
                @if (problem is not null)
                {
                    <div class="wb-errt" role="alert">@ProblemText(c, key, problem)</div>
                }
            </div>
        </div>;
    }

    private RenderFragment RuleReadPanel(Ctx c) => @<text>
        <h2 class="wb-h2">@Rich(PolicyKey(c.View.HitPolicy))</h2>
        @foreach (var row in c.View.Rows)
        {
            var target = RowTarget(row);
            <div class="wb-row">
                <span class="wb-num">@SimulationPresenter.Number(row)</span>
                <div>
