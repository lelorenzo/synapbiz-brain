    private RenderFragment SimulatePanel(Ctx c)
    {
        if (c.Broken)
        {
            return BrokenNote();
        }

        var work = c.Work;
        var form = work.Simulator;
        form.EnsureDefaults(c.Shown);
        var run = c.Run;
        var selectId = idp + "-load";

        return @<text>
            @Band("band.simulate", c.Editing)
            <div class="wb-grid2">
                <div class="wb-card">
                    <h2 class="wb-h2">@Rich("sim.title")</h2>
                    @FactFields(c.Brain, form, c.Shown, "sim", () => FieldChanged(work))
                    <div class="wb-actions">
                        <button type="button" class="wb-btn wb-btn-primary" @onclick="() => RunSimulation(c, work)">@Rich("sim.run")</button>
                        <button type="button" class="wb-btn wb-btn-secondary" @onclick="() => ClearSimulation(work, c.Shown)">@Rich("sim.clear")</button>
                    </div>
                    @if (run.Cases.Count > 0)
                    {
                        <label class="wb-hint wb-hint-gap" for="@selectId">@Rich("sim.loadCase")</label>
                        <select id="@selectId" class="wb-in" value="@work.LoadedCase" @onchange="args => LoadCase(work, c.Shown, run.Cases, args)">
                            <option value="">@Plain("sim.loadCaseNone")</option>
                            @for (var position = 0; position < run.Cases.Count; position++)
                            {
                                <option value="@position.ToString(CultureInfo.InvariantCulture)">@run.Cases[position].Name</option>
                            }
                        </select>
                    }
                </div>
                <div class="wb-live" aria-live="polite">
                    @SimulationResult(c)
                </div>
            </div>
        </text>;
    }

    private RenderFragment SimulationResult(Ctx c)
    {
        var work = c.Work;
        var result = work.Result;
        if (work.Simulator.Errors.Count > 0)
        {
            return @<div class="wb-sub">@Rich("refuse.fixData")</div>;
        }

        if (result is null)
        {
            return @<div class="wb-sub">@Rich("sim.before")</div>;
        }

        var stale = work.Stale ? " wb-stale" : string.Empty;
        if (!result.Succeeded)
        {
            var code = result.Failure!.Code;
            var refusal = RefusalText.For(text, c.View, work.ResultFacts ?? new Dictionary<string, DecisionValue>(), code);
            return @<div class="@("wb-result wb-result-fail" + stale)" role="alert">
                @if (work.Stale)
                {
                    <div class="wb-stale-note">@Rich("sim.stale")</div>
                }
                <h2 class="wb-h2 wb-h2-flush">@Rich("refuse.title")</h2>
                <div class="wb-refuse-line">@Rich("refuse.intro") @refusal.Line</div>
                @if (refusal.WayOut == RefusalWayOut.FixData)
                {
                    <div class="wb-small">@Rich("refuse.fixData")</div>
                }
                else
                {
                    <div class="wb-small">@Rich("refuse.addToReview")</div>
                    <div class="wb-actions wb-actions-tight">
                        <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => AddRefusalToReview(work, code)">@Rich("refuse.addButton")</button>
                    </div>
                }
            </div>;
        }

        var labels = c.Labels;
        var decided = result.Outcome as Decided;
        var groups = decided is null ? [] : OutcomeFormat.Groups(c.View, labels, Locale, decided.OutcomeJson);
        var why = SimulationPresenter.Why(text, c.Brain, c.View, labels, result);
        var deciding = SimulationPresenter.DecidingKeys(result);
        var composed = result.Rows.Count == 0 && c.Brain.Kind.Facts.Any(fact => fact.ComposedFromKind is not null);
        var folded = SimulationPresenter.RowCount(c.View) > SimulationPresenter.FoldAfter && !work.ShowAllRows;
        var shownRows = result.Rows.Where(row => !folded || row.Selected || (row.Matched && !row.IsDefault)).ToList();
        var hiddenCount = result.Rows.Count - shownRows.Count;

        return @<text>
            <div class="@((decided is null ? "wb-result wb-result-none" : "wb-result") + stale)">
                @if (work.Stale)
                {
                    <div class="wb-stale-note">@Rich("sim.stale")</div>
                }
                <div class="wb-result-head">
                    <h2 class="wb-h2 wb-h2-flush">@(decided is null ? Rich("sim.noDecision") : Rich("sim.resultTitle", ("values", OutcomeFormat.HeadlineSummary(groups, c.Rule.HeadlineFields))))</h2>
                    <span class="@PillClass("sim")">@Rich("pill.simulation")</span>
                </div>
                @if (why is not null)
                {
                    <div class="wb-sub wb-why">@why</div>
                }
                @for (var position = 0; position < groups.Count; position++)
                {
                    var group = groups[position];
                    @if (groups.Count > 1 && position < deciding.Count)
                    {
                        <div class="wb-sub wb-group-note">@Plain("row.label", ("n", SimulationPresenter.RowNumbers(text, c.View, [deciding[position]])))</div>
                    }
                    <dl class="wb-kv">
                        @foreach (var field in group)
                        {
                            <dt>@field.Label</dt>
                            <dd>@field.Text</dd>
                        }
                    </dl>
                }
                @if (composed)
                {
                    <div class="wb-sub">@Rich("sim.composedNote")</div>
                }
                <div class="wb-actions wb-actions-tight">
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => OpenFormFromSimulation(c.Rule, c.Brain, work, c.Shown, c.View, labels)">@Rich("sim.saveAsCase")</button>
                </div>
            </div>
            @if (result.Rows.Count > 0)
            {
                <h2 class="wb-h2">@Rich("sim.rowByRow")</h2>
                @foreach (var explanation in shownRows)
                {
                    var row = SimulationPresenter.RowByKey(c.View, explanation.Key);
                    if (row is null)
                    {
                        continue;
                    }

                    var word = SimulationPresenter.Word(explanation);
                    var listed = row.Conditions.Where(condition => !SimulationPresenter.AcceptsAny(c.Brain, row, condition)).ToList();
                    <div class="@(RowClass(explanation.Selected) + stale)">
                        <span class="wb-num">@SimulationPresenter.Number(row)</span>
                        <div>
                            <div class="wb-sent">@(explanation.Selected ? row.Sentence : SimulationPresenter.ShortSentence(text, c.Brain, row))</div>
                            @if (listed.Count == 0 && !row.IsDefault)
                            {
                                <div class="wb-cond"><span class="wb-cond-text">@Rich("row.always")</span></div>
                            }
                            @foreach (var condition in listed)
                            {
                                var check = explanation.Conditions.FirstOrDefault(item => item.Index == condition.Index);
                                var met = check is { Passed: true };
                                var typed = check is null ? string.Empty : WorkbenchText.FormatValue(check.Actual, condition.FactName, Locale, labels);
                                var entered = EnteredText(met, condition.Operator, typed);
                                <div class="wb-cond">
                                    <span class="@PillClass(met ? "ok" : "neutral")">@Rich(met ? "cond.met" : "cond.notMet")</span>
                                    <span class="wb-cond-text">@(SimulationPresenter.Capitalize(condition.Text) + "." + (entered.Length > 0 ? " " + entered : string.Empty))</span>
                                </div>
                            }
                            @if (word.Key == "row.matchesNoDecide" && c.View.HitPolicy == HitPolicy.First)
                            {
                                <div class="wb-sub">@Rich("row.earlier")</div>
                            }
                        </div>
                        <span class="@PillClass(word.Tone)">@Rich(word.Key)</span>
                    </div>
                }
                @if (hiddenCount > 0)
                {
                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => { work.ShowAllRows = true; Session.Touch(); }">@Rich("sim.showAll", ("n", OutcomeFormat.Number(hiddenCount)))</button>
                }
            }
        </text>;
    }

    // ----- Tests ------------------------------------------------------------------------------------------------------

    private RenderFragment TestsPanel(Ctx c)
    {
        if (c.Broken)
        {
            return BrokenNote();
        }

        if (c.Editing)
        {
            return DraftTestsPanel(c);
        }

        var work = c.Work;
        var run = c.Run;
        var labels = c.Labels;
        var form = caseForm is not null && string.Equals(caseForm.RuleKey, c.Rule.Key, StringComparison.Ordinal) ? caseForm : null;
        var failing = run.FailedCount > 0;

        return @<text>
            @Band("band.tests", c.Editing)
            @if (form is not null)
            {
                @CaseFormPanel(c, form)
            }
            <div class="wb-bar">
                <h2 class="wb-h2 wb-h2-flush">@TestsHeading(run)</h2>
                <span class="wb-sp"></span>
                <button type="button" class="wb-btn wb-btn-secondary" @onclick="() => OpenCaseForm(c.Rule, c.Shown)">@Rich("tests.add")</button>
                <button type="button" class="wb-btn wb-btn-primary" disabled="@testsRunning" @onclick="() => RunAllAsync(c.Rule, work)">@Rich(testsRunning ? "tests.running" : "tests.runAll")</button>
            </div>
            @if (run.Cases.Count > 0)
            {
                <table class="wb-table">
                    <thead>
                        <tr>
                            <th scope="col">@Rich("tests.th.case")</th>
                            <th scope="col">@Rich("tests.th.data")</th>
                            <th scope="col">@Rich("tests.th.expected")</th>
                            <th scope="col">@Rich("tests.th.actual")</th>
                            <th scope="col">@Rich("tests.th.status")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var testCase in run.Cases)
                        {
                            var target = CaseTarget(testCase.Name);
                            <tr class="@(testCase.Passed ? null : "wb-fail-row")">
                                <td>
                                    @if (testCase.Passed)
                                    {
                                        @testCase.Name
                                    }
                                    else
                                    {
                                        <strong>@testCase.Name</strong>
                                    }
                                    @if (!testCase.FromDocument)
                                    {
                                        <div class="wb-sub"><span class="@PillClass("neutral")">@Rich("tests.proposed")</span></div>
                                    }
                                </td>
                                <td>@OutcomeFormat.FactsText(c.Brain, c.View, labels, Locale, testCase.Facts)</td>
                                <td>@ExpectedText(c.View, labels, testCase.Expected)</td>
                                <td>
                                    @if (testCase.Passed)
                                    {
                                        @ActualText(c.View, labels, testCase)
                                    }
                                    else
                                    {
                                        <strong>@ActualText(c.View, labels, testCase)</strong>
                                        @if (testCase.Failure is null)
                                        {
                                            <div class="wb-sub">@DecidedByText(c.View, testCase)</div>
                                        }
                                    }
                                </td>
                                <td>
                                    <span class="@PillClass(testCase.Passed ? "ok" : "bad")">@Rich(testCase.Passed ? "tests.pass" : "tests.fail")</span>
                                    @if (!testCase.Passed)
                                    {
                                        <div class="wb-cell-gap"><button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => OpenCaseInSimulator(work, c.Shown, testCase)">@Rich("tests.openSim")</button></div>
                                    }
                                    @if (testCase.FromDocument)
                                    {
                                        var state = work.Review(target).State;
                                        var lineOpen = work.OpenLines.Contains(target);
                                        <div class="wb-cell-gap">
                                            @if (state == ReviewState.Unreviewed)
                                            {
                                                <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-expanded="@(lineOpen ? "true" : "false")" aria-controls="@LineId(target)" @onclick="() => ToggleLine(work, target)">@Rich("tests.review")</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="@(PillClass(StateTone(state)) + " wb-pill-btn")" aria-expanded="@(lineOpen ? "true" : "false")" aria-controls="@LineId(target)" @onclick="() => ToggleLine(work, target)">@StateWord(state)</button>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                            @if (testCase.FromDocument && work.OpenLines.Contains(target))
                            {
                                <tr class="wb-review-line" id="@LineId(target)">
                                    <td colspan="5">
                                        @ReviewControl(work, target, Plain("review.groupCase", ("name", testCase.Name)))
                                        @NoteEditor(work, target, "review.noteLabel")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            @if (failing)
            {
                <div class="wb-notice wb-notice-gap" role="note">@Rich("tests.failNote")</div>
            }
            <h2 class="wb-h2 wb-h2-gap">@Rich("tests.uncovered")</h2>
            @if (run.UncoveredRowKeys.Count == 0)
            {
                <div class="wb-sub wb-sub-flush">@Rich("tests.allCovered")</div>
            }
            else
            {
                foreach (var key in run.UncoveredRowKeys)
                {
                    var row = SimulationPresenter.RowByKey(c.View, key);
                    if (row is null)
                    {
                        continue;
                    }

                    <div class="wb-row">
                        <span class="wb-num">@SimulationPresenter.Number(row)</span>
                        <div class="wb-sent">@row.Sentence</div>
                        <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => OpenFormForRow(c.Rule, c.Brain, c.Shown, c.View, labels, key)">@Rich("tests.createFor")</button>
                    </div>
                }
            }
        </text>;
    }

    private RenderFragment DraftTestsPanel(Ctx c)
    {
        var draft = c.Draft!;
        var readOnly = IsStale(c.Rule, draft);
        var run = c.Run;
        var labels = c.Labels;
        var form = readOnly || caseForm is null || !string.Equals(caseForm.RuleKey, c.Rule.Key, StringComparison.Ordinal) ? null : caseForm;
        var lines = CaseLines(c);
        var changedRows = ChangedRowKeys(c);
        var failing = lines.Exists(line => !line.Removed && !line.Case.Passed && !line.Changes);
        var changing = lines.Count(line => line.Changes);

        return @<text>
            @Band("band.tests", true)
            @if (draft.Refusal is { RowKey: null } top)
            {
                @RefusalBox(top.Lines, false)
            }
            @if (form is not null)
            {
                @CaseFormPanel(c, form)
            }
            <div class="wb-bar">
                <h2 class="wb-h2 wb-h2-flush">@TestsHeading(run, changing)</h2>
                <span class="wb-sp"></span>
                @if (!readOnly)
                {
                    <button type="button" class="wb-btn wb-btn-secondary" @onclick="() => OpenCaseForm(c.Rule, c.Shown)" @ref="refs[CaseAddRef]">@Rich("tests.add")</button>
                }
                <button type="button" class="wb-btn wb-btn-primary" disabled="@testsRunning" @onclick="() => RunDraftAgainAsync(draft)">@Rich(testsRunning ? "tests.running" : "tests.runAll")</button>
            </div>
            @if (lines.Count > 0)
            {
                <table class="wb-table">
                    <thead>
                        <tr>
                            <th scope="col">@Rich("tests.th.case")</th>
                            <th scope="col">@Rich("tests.th.data")</th>
                            <th scope="col">@Rich("tests.th.expected")</th>
                            <th scope="col">@Rich("tests.th.draft")</th>
                            <th scope="col">@Rich("tests.th.status")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in lines)
                        {
                            var testCase = line.Case;
                            var name = line.Name;
                            var bad = !line.Removed && !testCase.Passed;
                            <tr class="@CaseRowClass(line)">
                                <td>
                                    @if (line.Removed)
                                    {
                                        <span class="wb-struck">@name</span>
                                    }
                                    else if (bad)
                                    {
                                        <strong>@name</strong>
                                    }
                                    else
                                    {
                                        @name
                                    }
                                    @if (line.IsNew || line.Removed)
                                    {
                                        <div class="wb-sub"><span class="@PillClass(line.IsNew ? "ok" : "neutral")">@Rich(line.IsNew ? "case.tagNew" : "case.tagRemoved")</span></div>
                                    }
                                </td>
                                <td>@OutcomeFormat.FactsText(c.Brain, c.View, labels, Locale, testCase.Facts)</td>
                                <td>
                                    <span class="@(line.Removed ? "wb-struck" : null)">@ExpectedText(c.View, labels, testCase.Expected)</span>
                                    @if (line.Changes)
                                    {
                                        <div class="wb-sub">@Rich("case.currentGives")</div>
                                    }
                                </td>
                                <td>
                                    @if (line.Removed)
                                    {
                                        <span class="wb-struck">@ActualText(c.View, labels, testCase)</span>
                                    }
                                    else if (!bad)
                                    {
                                        @ActualText(c.View, labels, testCase)
                                    }
                                    else
                                    {
                                        <strong>@ActualText(c.View, labels, testCase)</strong>
                                        @if (line.Changes)
                                        {
                                            <div class="wb-sub">@NowDecidedBy(c, line, changedRows)</div>
                                        }
                                        else if (testCase.Failure is null)
                                        {
                                            <div class="wb-sub">@DecidedByText(c.View, testCase)</div>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (line.Removed)
                                    {
                                        @if (!readOnly)
                                        {
                                            <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("case.restoreFor", ("name", name))" @onclick="() => RestoreCase(c, name)" @ref="refs[CaseRestoreRef(name)]">@Rich("row.restore")</button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="@PillClass(line.Changes || !testCase.Passed ? "bad" : "ok")">@Rich(CasePillKey(line))</span>
                                        @if (line.Decided)
                                        {
                                            <div class="wb-cell-gap"><span class="@PillClass("neutral")">@Rich("case.expectChanged")</span></div>
                                            @if (!readOnly)
                                            {
                                                <div class="wb-cell-gap"><button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("case.undoFor", ("name", name))" @onclick="() => UndoCaseDecision(c, name)" @ref="refs[CaseUndoRef(name)]">@Rich("row.undo")</button></div>
                                            }
                                        }
                                        @if (bad && !line.Changes)
                                        {
                                            <div class="wb-cell-gap"><button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => OpenCaseInSimulator(c.Work, c.Shown, testCase)">@Rich("tests.openSim")</button></div>
                                        }
                                        @if (!readOnly)
                                        {
                                            <div class="wb-cell-gap"><button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("case.changeFor", ("name", name))" @onclick="() => OpenCaseEdit(c, line)" @ref="refs[CaseChangeRef(name)]">@Rich("case.change")</button></div>
                                            <div class="wb-cell-gap"><button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("case.removeFor", ("name", name))" @onclick="() => RemoveCaseAction(c, line)">@Rich("case.remove")</button></div>
                                        }
                                    }
                                </td>
                            </tr>
                            @if (line.Changes && !readOnly && line.Change is { } change)
                            {
                                var askId = idp + "-ask-" + lines.IndexOf(line).ToString(CultureInfo.InvariantCulture);
                                <tr class="wb-review-line">
                                    <td colspan="5">
                                        <div class="wb-ask" role="group" aria-labelledby="@askId">
                                            <strong id="@askId">@Rich("case.ask")</strong>
                                            <button type="button" class="wb-btn wb-btn-primary wb-btn-sm" @onclick="() => AcceptCase(c, line)" @ref="refs[AcceptRef(name)]">@Rich("case.accept", ("result", change.After))</button>
                                            <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => ReviewMyChange(c, line)">@Rich("case.reviewMine", ("result", change.Before))</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            @if (failing)
            {
                <div class="wb-notice wb-notice-gap" role="note">@Rich("tests.failNote")</div>
            }
            <h2 class="wb-h2 wb-h2-gap">@Rich("tests.uncovered")</h2>
            @if (run.UncoveredRowKeys.Count == 0)
            {
                <div class="wb-sub wb-sub-flush">@Rich("tests.allCovered")</div>
            }
            else
            {
                foreach (var key in run.UncoveredRowKeys)
                {
                    var row = SimulationPresenter.RowByKey(c.View, key);
                    if (row is null)
                    {
                        continue;
                    }

                    <div class="wb-row">
                        <span class="wb-num">@SimulationPresenter.Number(row)</span>
                        <div class="wb-sent">@row.Sentence</div>
                        @if (!readOnly)
                        {
                            <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => OpenFormForRow(c.Rule, c.Brain, c.Shown, c.View, labels, key)">@Rich("tests.createFor")</button>
                        }
                    </div>
                }
            }
        </text>;
    }

    private RenderFragment CaseFormPanel(Ctx c, CaseForm form)
    {
        var options = CaseForm.Options(c.Brain, c.View, c.Labels, Locale);
        var collect = c.View.HitPolicy == HitPolicy.Collect;
        var nameId = idp + "-case-name";
        var expectedId = idp + "-case-expected";
        var current = CurrentOption(form);

        return @<div class="wb-card wb-case-form">
            @PrivacyNotice()
            <h2 class="wb-h2">@(form.EditName is { } editing ? Rich("case.editTitle", ("name", editing)) : Rich("tests.add"))</h2>
            @if (form.EditName is null)
            {
                <div class="wb-field">
                    <label class="wb-label" for="@nameId">@Rich("case.name")</label>
                    <input id="@nameId" type="text" autocomplete="off" maxlength="200" class="@(form.NameError is null ? "wb-in" : "wb-in wb-in-err")" value="@form.Name" aria-describedby="@(form.NameError is null ? null : nameId + "-err")" aria-invalid="@(form.NameError is null ? null : "true")" @onchange="args => SetCaseName(form, args)" @ref="refs[CaseNameRef]" />
                    @if (form.NameError is not null)
                    {
                        <div class="wb-errt" id="@(nameId + "-err")">@Rich(form.NameError)</div>
                    }
                </div>
                @FactFields(c.Brain, form.Facts, c.Shown, "case", null)
            }
            <div class="wb-field">
                @if (collect)
                {
                    <span class="wb-label" id="@(expectedId + "-label")">@Rich("case.expected")</span>
                    <div class="wb-radios wb-radios-stack" role="group" aria-labelledby="@(expectedId + "-label")">
                        @foreach (var option in options)
                        {
                            var index = option.Index;
                            <label class="wb-radio"><input type="checkbox" checked="@form.Chosen.Contains(index)" @onchange="args => ChooseOption(form, index, c.View.HitPolicy, args.Value is true)" />@option.Text</label>
                        }
                        <label class="wb-radio"><input type="checkbox" checked="@form.ExpectNone" @onchange="args => ChooseNone(form, args.Value is true)" @ref="refs[CaseExpectedRef]" />@Rich("result.none")</label>
                    </div>
                }
                else
                {
                    <label class="wb-label" for="@expectedId">@Rich("case.expected")</label>
                    <select id="@expectedId" class="@(form.ExpectedError is null ? "wb-in" : "wb-in wb-in-err")" value="@current" @onchange="args => ChooseOptionFromSelect(form, args, c.View.HitPolicy)" @ref="refs[CaseExpectedRef]">
                        <option value="">@Plain("case.pick")</option>
                        <option value="none">@Plain("result.none")</option>
                        @foreach (var option in options)
                        {
                            <option value="@option.Index.ToString(CultureInfo.InvariantCulture)">@option.Text</option>
                        }
                    </select>
                }
                @if (form.ExpectedError is not null)
                {
                    <div class="wb-errt">@Rich(form.ExpectedError)</div>
                }
            </div>
            @if (form.Refusal is { } refusal)
            {
                @RefusalBox(refusal, false)
            }
            <div class="wb-actions">
                <button type="button" class="wb-btn wb-btn-primary" @onclick="() => SaveAnyCase(c)">@Rich(c.Editing ? "case.apply" : "case.save")</button>
                <button type="button" class="wb-btn wb-btn-secondary" @onclick="CancelCaseForm">@Rich("case.cancel")</button>
            </div>
        </div>;
    }

    // ----- Changes ----------------------------------------------------------------------------------------------------

    private RenderFragment ChangesPanel(Ctx c)
    {
        if (c.Broken)
        {
            return BrokenNote();
        }

        var draft = c.Draft!;
        var readOnly = IsStale(c.Rule, draft);
        var change = ChangesOf(c.Rule, draft);
        var rowItems = change.Rows;
        var baseView = Context(c.Rule, baseOnly: true).View;
        var lines = CaseLines(c);
        var changing = readOnly ? 0 : lines.Count(line => line.Changes);
        var warnings = DraftWarnings(c);
        var changed = rowItems.Count + (change.DefaultRowChanged ? 1 : 0);
        var counts = PluralText("discard.rows", changed) + Separator + PluralText("discard.cases", draft.CaseStepCount);
        var reasonId = idp + "-reason";
        var nameId = idp + "-proposer";
        var canExport = draft.HasChanges && changing == 0;

        return @<text>
            <div class="wb-notice" role="note">@Rich("notice.privacyReason")</div>
            <div class="wb-grid2 wb-grid-review">
                <div>
                    <h2 class="wb-h2">@Rich("changes.rows")</h2>
                    <div class="wb-sub wb-sub-flush">@change.Summary</div>
                    @foreach (var item in rowItems)
                    {
                        var key = item.Key;
                        var number = (item.NumberAfter ?? item.NumberBefore ?? 0).ToString(CultureInfo.InvariantCulture);
                        <div class="wb-card wb-card-gap wb-changed" data-tag="@item.Tag.ToString().ToLowerInvariant()">
                            <div class="wb-card-head">
                                <strong>@Plain("row.label", ("n", number))</strong>
                                <span class="@PillClass(TagTone(item.Tag))">@Rich(TagKey(item.Tag))</span>
                                <span class="wb-sp"></span>
                                @if (!readOnly)
                                {
                                    @if (item.Tag == RowChangeTag.Removed)
                                    {
                                        <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("row.restoreFor", ("n", number))" @onclick="() => UndoFromChanges(c, key, step => step.Kind == StepKind.Remove && step.Key == key)">@Rich("row.restore")</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("row.undoFor", ("n", number))" @onclick="() => UndoFromChanges(c, key, step => step.Key == key && step.Kind is StepKind.Add or StepKind.Row or StepKind.Move)">@Rich("row.undo")</button>
                                    }
                                }
                            </div>
                            @if (item.SentenceBefore is { } before && !IsNameOnly(item))
                            {
                                <div class="wb-sub wb-sub-flush"><span class="wb-before">@Rich("row.before")</span> <span class="@(item.Tag == RowChangeTag.Removed ? "wb-struck" : null)">@before</span></div>
                            }
                            @if (IsRenamed(item))
                            {
                                <div class="wb-sent">@RenameText(item)</div>
                            }
                            @if (item.SentenceAfter is { } after && !IsNameOnly(item))
                            {
                                <div class="wb-sent"><span class="wb-before">@Rich("changes.now")</span> @after</div>
                            }
                        </div>
                    }
                    @if (change.DefaultRowChanged && baseView.DefaultRow is { } was && c.View.DefaultRow is { } now)
                    {
                        var defaultKey = c.Brain.Table.DefaultRow!.Key;
                        <div class="wb-card wb-card-gap wb-changed" data-tag="default">
                            <div class="wb-card-head">
                                <strong>@Rich("changes.defaultRow")</strong>
                                <span class="@PillClass("warn")">@Rich("tag.changed")</span>
                                <span class="wb-sp"></span>
                                @if (!readOnly)
                                {
                                    <button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" aria-label="@Plain("row.undoFor", ("n", "–"))" @onclick="() => UndoFromChanges(c, defaultKey, step => step.Key == defaultKey && step.Kind == StepKind.Row)">@Rich("row.undo")</button>
                                }
                            </div>
                            <div class="wb-sub wb-sub-flush"><span class="wb-before">@Rich("row.before")</span> @was.Sentence</div>
                            <div class="wb-sent"><span class="wb-before">@Rich("changes.now")</span> @now.Sentence</div>
                        </div>
                    }
                    @if (warnings.Count > 0)
                    {
                        <h2 class="wb-h2 wb-h2-gap">@Rich("changes.warnings")</h2>
                        <ul class="wb-warnings">
                            @foreach (var warning in warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    }
                    <h2 class="wb-h2 wb-h2-gap">@Rich("changes.cases")</h2>
                    @if (change.CasesThatChange.Count == 0)
                    {
                        <div class="wb-sub wb-sub-flush">@Rich("changes.noCases")</div>
                    }
                    else
                    {
                        <table class="wb-table">
                            <thead>
                                <tr>
                                    <th scope="col">@Rich("tests.th.case")</th>
                                    <th scope="col">@Rich("changes.th.before")</th>
                                    <th scope="col">@Rich("changes.th.now")</th>
                                    <th scope="col">@Rich("changes.th.decision")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in change.CasesThatChange)
                                {
                                    var line = lines.Find(item => item.Name == entry.Name);
                                    <tr>
                                        <td>@entry.Name</td>
                                        <td>@entry.Before</td>
                                        <td>@entry.After</td>
                                        <td>@CaseDecisionPill(line)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="wb-card">
                    <h2 class="wb-h2">@Rich("changes.card")</h2>
                    <div class="wb-sub wb-sub-flush">@counts</div>
                    @if (OnExport is not null)
                    {
                        <div class="wb-field wb-field-gap">
                            <label class="wb-label" for="@reasonId">@Rich("changes.reason")</label>
                            <textarea id="@reasonId" class="@(draft.ReasonError ? "wb-in wb-in-err" : "wb-in")" rows="4" maxlength="@NoteMax" value="@draft.Reason" aria-describedby="@(draft.ReasonError ? reasonId + "-err" : null)" aria-invalid="@(draft.ReasonError ? "true" : null)" @onchange="args => SetReason(draft, args)" @ref="refs[ReasonRef]"></textarea>
                            @if (draft.Reason.Length >= NoteCounterFrom)
                            {
                                <div class="wb-hint">@Plain("review.counter", ("n", OutcomeFormat.Number(draft.Reason.Length)), ("max", OutcomeFormat.Number(NoteMax)))</div>
                            }
                            @if (draft.ReasonError)
                            {
                                <div class="wb-errt" id="@(reasonId + "-err")">@Rich("changes.reasonRequired")</div>
                            }
                        </div>
                        <div class="wb-field wb-field-gap">
                            <label class="wb-label" for="@nameId">@Rich("review.name")</label>
                            <input id="@nameId" type="text" autocomplete="off" class="@(draft.NameError ? "wb-in wb-in-err" : "wb-in")" value="@Session.Reviewer" aria-describedby="@(draft.NameError ? nameId + "-err" : null)" aria-invalid="@(draft.NameError ? "true" : null)" @onchange="args => SetProposalName(draft, args)" @ref="refs[ProposalNameRef]" />
                            @if (draft.NameError)
                            {
                                <div class="wb-errt" id="@(nameId + "-err")">@Rich("changes.nameRequired")</div>
                            }
                        </div>
                        <div class="wb-actions">
                            <button type="button" class="wb-btn wb-btn-primary" disabled="@(!canExport)" @onclick="() => ExportProposalAsync(c.Rule)">@Rich("changes.export")</button>
                        </div>
                        @if (changing > 0)
                        {
                            <div class="wb-errt" role="note">@Rich(UiText.Plural("changes.held", changing), ("n", OutcomeFormat.Number(changing)))</div>
                        }
                        @if (!draft.HasChanges)
                        {
                            <div class="wb-hint">@Rich("changes.nothing")</div>
                        }
                        <div class="wb-hint">@Rich("export.proposal.explain")</div>
                        @if (draft.IsExported)
                        {
                            <div class="wb-saved" role="status">@(draft.ExportPlace is null ? Rich("changes.savedNoPlace") : Rich("changes.saved", ("place", draft.ExportPlace)))</div>
                        }
                    }
                </div>
            </div>
        </text>;
    }

    private RenderFragment CaseDecisionPill(CaseLine? line)
    {
        if (line is { Removed: true })
        {
            return @<span class="@PillClass("neutral")">@Rich("case.tagRemoved")</span>;
        }

        if (line is { Decided: true })
        {
            return @<span class="@PillClass("neutral")">@Rich("case.expectChanged")</span>;
        }

        return line is { Changes: true } ? @<span class="@PillClass("bad")">@Rich("changes.undecided")</span> : @<text>–</text>;
    }

    // ----- Review -----------------------------------------------------------------------------------------------------

    private RenderFragment ReviewPanel(Ctx c)
    {
        var work = c.Work;
        var counts = CountReview(c.Rule, work, c.View);
        var run = c.Run;
        var labels = c.Labels;
        var rowItems = c.View.Rows.Where(row => work.Review(RowTarget(row)).IsExported).ToList();
        var unreviewed = c.View.Rows.Where(row => !work.Review(RowTarget(row)).IsExported).ToList();
        var goldenItems = c.Brain.Goldens.Where(golden => work.Review(CaseTarget(golden.Name)).IsExported).ToList();
        var hasItems = rowItems.Count + goldenItems.Count + work.Cases.Count > 0;
        var ruleExported = work.Review("rule").IsExported;
        var exportable = ExportableRuleCount();
        var scopeText = PluralText("review.scope", exportable);
        var summary = new List<string>
        {
            PluralText("review.summary.rows", counts.RowCount, ("n", OutcomeFormat.Number(counts.ReviewedRows)), ("t", OutcomeFormat.Number(counts.RowCount))),
        };
        if (counts.Questions > 0)
        {
            summary.Add(PluralText("review.summary.questions", counts.Questions));
        }

        if (counts.Fixes > 0)
        {
            summary.Add(PluralText("review.summary.fixes", counts.Fixes));
        }

        if (counts.Cases > 0)
        {
            summary.Add(PluralText("review.summary.cases", counts.Cases));
        }

        var reviewerId = idp + "-reviewer";
        var missingNotes = MissingNoteCount();

        return @<text>
            @PrivacyNotice()
            <div class="wb-grid2 wb-grid-review">
                <div>
                    <h2 class="wb-h2">@Rich("review.title")</h2>
                    <div class="wb-card wb-card-gap">
                        <div class="wb-card-head">
                            <strong>@Rich("review.ruleTarget")</strong>
                            <span class="wb-sp"></span>
                            @ReviewControl(work, "rule", Plain("review.groupRule"))
                        </div>
                        @NoteEditor(work, "rule", "review.noteShort")
                        @if (work.Review("rule").NeedsNote)
                        {
                            <div class="wb-cell-gap">@MissingNote(work, "rule")</div>
                        }
                    </div>
                    @if (!hasItems && !ruleExported)
                    {
                        <div class="wb-sub">@Rich("review.empty")</div>
                    }
                    else if (hasItems)
                    {
                        <table class="wb-table">
                            <thead>
                                <tr>
                                    <th scope="col">@Rich("review.th.about")</th>
                                    <th scope="col">@Rich("review.th.state")</th>
                                    <th scope="col">@Rich("review.th.note")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in rowItems)
                                {
                                    var entry = work.Review(RowTarget(row));
                                    <tr>
                                        <td>@Plain("row.label", ("n", SimulationPresenter.Number(row)))<div class="wb-sub">@row.Sentence</div></td>
                                        <td><span class="@PillClass(StateTone(entry.State))">@StateWord(entry.State)</span></td>
                                        <td>@if (entry.NeedsNote) { @MissingNote(work, RowTarget(row)) } else if (entry.Note.Length > 0) { @entry.Note } else { <span class="wb-sub">@Rich("review.noNote")</span> }</td>
                                    </tr>
                                }
                                @foreach (var goldenName in goldenItems.Select(golden => golden.Name))
                                {
                                    var entry = work.Review(CaseTarget(goldenName));
                                    <tr>
                                        <td>@Plain("review.case", ("name", goldenName))</td>
                                        <td><span class="@PillClass(StateTone(entry.State))">@StateWord(entry.State)</span></td>
                                        <td>@if (entry.NeedsNote) { @MissingNote(work, CaseTarget(goldenName)) } else if (entry.Note.Length > 0) { @entry.Note } else { <span class="wb-sub">@Rich("review.noNote")</span> }</td>
                                    </tr>
                                }
                                @foreach (var proposedName in work.Cases.Select(proposed => proposed.Name))
                                {
                                    var result = run.Cases.FirstOrDefault(item => !item.FromDocument && item.Name == proposedName);
                                    <tr>
                                        <td>@Plain("review.case", ("name", proposedName))</td>
                                        <td><span class="@PillClass("neutral")">@Rich("review.proposed")</span></td>
                                        <td>@(result is null ? string.Empty : Plain("review.proposedNote", ("expected", ExpectedText(c.View, labels, result.Expected)), ("actual", ActualText(c.View, labels, result))))</td>
                                    </tr>
                                }
                                @if (unreviewed.Count > 0)
                                {
                                    <tr>
                                        <td>@PluralText("review.rowsUnreviewed", unreviewed.Count, ("rows", SimulationPresenter.JoinWords(text, unreviewed.Select(SimulationPresenter.Number).ToList())))</td>
                                        <td><span class="@PillClass("neutral")">@Rich("review.unreviewed")</span></td>
                                        <td><button type="button" class="wb-btn wb-btn-secondary wb-btn-sm" @onclick="() => SelectTab(WorkbenchTab.Read)">@Rich("review.goRead")</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="wb-card">
                    <h2 class="wb-h2">@Rich("review.cardTitle")</h2>
                    <div class="wb-sub wb-sub-flush">@string.Join(Separator, summary)</div>
                    @if (exportable > 0)
                    {
                        <div class="wb-hint">@scopeText</div>
                    }
                    @if (OnExport is not null)
                    {
                        <div class="wb-field wb-field-gap">
                            <label class="wb-label" for="@reviewerId">@Rich("review.name")</label>
                            <input id="@reviewerId" type="text" autocomplete="off" class="@(nameError ? "wb-in wb-in-err" : "wb-in")" value="@Session.Reviewer" aria-describedby="@(nameError ? reviewerId + "-err" : null)" aria-invalid="@(nameError ? "true" : null)" @onchange="SetReviewer" @ref="refs[ReviewerRef]" />
                            @if (nameError)
                            {
                                <div class="wb-errt" id="@(reviewerId + "-err")">@Rich("review.nameRequired")</div>
                            }
                        </div>
                        <div class="wb-actions">
                            <button type="button" class="wb-btn wb-btn-primary" disabled="@(exportable == 0)" @onclick="ExportAsync">@Rich("review.export")</button>
                        </div>
                        @if (notesHeld && missingNotes > 0)
                        {
                            <div class="wb-errt" role="alert">@Rich("review.notesNeeded", ("n", OutcomeFormat.Number(missingNotes)))</div>
                        }
                        @if (exportable == 0)
                        {
                            <div class="wb-hint">@Rich("review.nothingToExport")</div>
                        }
                        <div class="wb-hint">@Rich("review.exportHelp")</div>
                        @if (exportDone && Session.UnexportedRuleCount == 0)
                        {
                            <div class="wb-saved" role="status">@(exportPlace is null ? Rich("review.savedNoPlace") : Rich("review.saved", ("place", exportPlace)))</div>
                        }
                    }
                </div>
            </div>
        </text>;
    }
}
