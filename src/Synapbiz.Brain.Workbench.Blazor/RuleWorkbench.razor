                        <div class="wb-row-title">@row.Title</div>
                    }
                    <div class="wb-sent">@row.Sentence</div>
                    @if (c.Rule.RowTexts.TryGetValue(row.RowId, out var shownText))
                    {
                        <div class="wb-sub">@Rich("read.rowTextPrefix") «@shownText»</div>
                    }
