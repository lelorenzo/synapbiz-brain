<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Synapbiz.Brain.Host.Postgres</RootNamespace>
    <AssemblyName>Synapbiz.Brain.Host.Postgres</AssemblyName>
    <PackageId>Synapbiz.Brain.Host.Postgres</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Durable PostgreSQL host for brain.process@1 instances: store, history, timers, waits, inbox, effects, worker and migrator.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Synapbiz.Brain.Process/Synapbiz.Brain.Process.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Synapbiz.Brain.Host.Postgres.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>

</Project>
