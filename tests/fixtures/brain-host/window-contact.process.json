{
  "$spec": "brain.process@1",
  "id": "host.window",
  "version": 1,
  "uses": [],
  "requires": [],
  "meta": { "title": "A contact action that is sent only in contact hours, with one retry" },
  "body": {
    "subject": "case",
    "stages": [],
    "variables": {
      "case_ref": { "type": "Code", "input": true }
    },
    "windows": {
      "contact_hours": { "zone": "America/New_York", "days": ["mon", "tue", "wed", "thu", "fri"], "from": "09:00", "to": "18:00" }
    },
    "start": "send",
    "steps": {
      "send": {
        "kind": "action",
        "port": "t.send",
        "delivery": "atLeastOnce",
        "contact": true,
        "window": "contact_hours",
        "input": { "case": "case_ref" },
        "retry": { "maxAttempts": 2, "backoff": "fixed", "initial": "PT5M" },
        "next": "done",
        "onError": "failed"
      },
      "done": { "kind": "end", "result": "sent" },
      "failed": { "kind": "end", "result": "failed" }
    }
  }
}
